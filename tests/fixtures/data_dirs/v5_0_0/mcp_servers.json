      "args": [
        "fixture-old-tool"
      ],
      "cwd": null,
      "env": {},
      "url": "",
      "headers": {},
      "connect_timeout": 30.0,
      "tool_timeout": 120.0,
      "output_limit": 24000,
      "trust_level": "standard",
      "requirements": [],
      "tools": {
        "enabled": {},
        "require_approval": [],
        "include": [],
        "exclude": [],
        "resources_enabled": false,
        "prompts_enabled": false
      },
      "source": {}
    }
  },
  "_client_publication": {
    "owner_id": "mcp:legacy-settings",
    "key": "6f1c2b8e-3d4a-4f5b-9c6d-7e8f9a0b1c2d",
