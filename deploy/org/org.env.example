# Row-Bot Org server settings for docker compose (copy this file to org.env and fill it in).
#
# Only the server's own ROW_BOT_ORG_* settings go here (README.md, Settings): it refuses to start with any
# other ROW_BOT_ORG_* variable. Passwords, database addresses, keys and the client secret are never here:
# they are the files in secrets/ (make_secrets.py). Values in single quotes are taken exactly as written.

# The address people's browsers use: https, with TLS in front (README.md, step 7). Use
# http://localhost:8100 only to try the server on this machine first.
ROW_BOT_ORG_PUBLIC_URL=https://rowbot.example.com

# Your identity provider, one JSON object on one line (README.md, Sign-in). Register
# <ROW_BOT_ORG_PUBLIC_URL>/auth/callback with it as the redirect URI, and paste its client secret into
# secrets/ROW_BOT_ORG_IDP_CLIENT_SECRET. Pick one of these and fill in your values:
#
# Microsoft Entra ID (your tenant's own issuer; set Assignment required = Yes on the enterprise application):
ROW_BOT_ORG_IDP='{"kind": "entra", "issuer": "https://login.microsoftonline.com/<tenant id>/v2.0", "client_id": "<application id>", "allowed_tenants": ["<tenant id>"]}'
#
# Okta:
# ROW_BOT_ORG_IDP='{"kind": "okta", "issuer": "https://<your org>.okta.com/oauth2/default", "client_id": "<client id>"}'
#
# Google Workspace (an Internal consent screen; your Workspace domains):
# ROW_BOT_ORG_IDP='{"kind": "google", "issuer": "https://accounts.google.com", "client_id": "<client id>", "hosted_domains": ["example.com"]}'
#
# To make the members of a provider group admins, map its id to a Row-Bot group and name that group (README.md,
# People and admins), for example: "group_map": {"<IT admins' group id>": "it-admins"}, "admin_groups": ["it-admins"]

# With a reverse proxy in front: the address it reaches the server from (README.md, Sign-in), for example the
# Compose network's gateway when the proxy runs on this host.
# ROW_BOT_ORG_TRUSTED_PROXIES=172.18.0.1

# ROW_BOT_ORG_LOG_LEVEL=INFO
