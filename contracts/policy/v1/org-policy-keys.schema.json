{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Row-Bot organisation policy signing keys",
  "description": "Ed25519 public keys that may sign org-policy.json. While this file is present, an unsigned policy file is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ed25519"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63})$",
            "description": "Names the signer in Settings."
          },
          "ed25519": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{43}=)$",
            "description": "The raw 32-byte public key, base64."
          }
        }
      }
    }
  }
}
