{
  "$defs": {
    "McpPluginTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "plugin",
          "title": "Kind",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "server_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Server Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "plugin_id",
        "server_key"
      ],
      "title": "McpPluginTarget",
      "type": "object"
    },
    "McpSecretBinding": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "env",
            "header"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "enum": [
            "",
            "Bearer ",
            "Basic "
          ],
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "key"
      ],
      "title": "McpSecretBinding",
      "type": "object"
    },
    "McpStandaloneTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "standalone",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "McpStandaloneTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "start",
        "disconnect"
      ],
      "title": "Action",
      "type": "string"
    },
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/McpSecretBinding"
      },
      "maxItems": 16,
      "title": "Bindings",
      "type": "array"
    },
    "configuration_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Revision",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Disclosures",
      "type": "array"
    },
    "label": {
      "default": "",
      "maxLength": 128,
      "title": "Label",
      "type": "string"
    },
    "mode": {
      "default": "oauth",
      "enum": [
        "oauth",
        "api_key"
      ],
      "title": "Mode",
      "type": "string"
    },
    "nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Nonce",
      "type": "string"
    },
    "server_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Server Id",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpStandaloneTarget"
        },
        {
          "$ref": "#/$defs/McpPluginTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    }
  },
  "required": [
    "server_id",
    "configuration_revision",
    "action",
    "action_digest",
    "disclosures",
    "nonce"
  ],
  "title": "McpAuthReview",
  "type": "object"
}
