{
  "$defs": {
    "ActionReadiness": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "send",
            "generate",
            "create_deck",
            "bind",
            "preview",
            "register_folder"
          ],
          "title": "Action",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "ready"
      ],
      "title": "ActionReadiness",
      "type": "object"
    },
    "ContextUsageView": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "estimated_input_tokens": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Input Tokens"
        },
        "last_confirmed_input_tokens": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Confirmed Input Tokens"
        },
        "model_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "native_window_tokens": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Window Tokens"
        },
        "state": {
          "enum": [
            "unknown",
            "saved",
            "stale"
          ],
          "title": "State",
          "type": "string"
        },
        "usable_input_tokens": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usable Input Tokens"
        }
      },
      "required": [
        "conversation_id",
        "state"
      ],
      "title": "ContextUsageView",
      "type": "object"
    },
    "ConversationControls": {
      "additionalProperties": false,
      "properties": {
        "approval_mode": {
          "default": "approve",
          "enum": [
            "block",
            "approve",
            "allow_all"
          ],
          "title": "Approval Mode",
          "type": "string"
        },
        "model_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_id": {
          "default": "",
          "maxLength": 128,
          "title": "Profile Id",
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningControl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime_mode": {
          "default": "agent",
          "enum": [
            "agent",
            "chat_only"
          ],
          "title": "Runtime Mode",
          "type": "string"
        }
      },
      "title": "ConversationControls",
      "type": "object"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "properties": {
        "model_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Ref",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "model_ref"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
    "ProfileChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ProfileChoice",
      "type": "object"
    },
    "ReasoningChoice": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ReasoningSelectionValue"
        }
      },
      "required": [
        "selection",
        "label"
      ],
      "title": "ReasoningChoice",
      "type": "object"
    },
    "ReasoningControl": {
      "additionalProperties": false,
      "properties": {
        "capability_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Revision",
          "type": "string"
        },
        "model_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Ref",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ReasoningSelectionValue"
        }
      },
      "required": [
        "model_ref",
        "capability_revision",
        "selection"
      ],
      "title": "ReasoningControl",
      "type": "object"
    },
    "ReasoningSelectionValue": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "effort": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "kind": {
          "enum": [
            "provider_default",
            "effort",
            "on",
            "off",
            "budget"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ReasoningSelectionValue",
      "type": "object"
    },
    "ReasoningView": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "budget_max": {
          "minimum": 0,
          "title": "Budget Max",
          "type": "integer"
        },
        "budget_min": {
          "minimum": 0,
          "title": "Budget Min",
          "type": "integer"
        },
        "capability_revision": {
          "maxLength": 128,
          "title": "Capability Revision",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/ReasoningChoice"
          },
          "maxItems": 32,
          "title": "Choices",
          "type": "array"
        },
        "model_ref": {
          "maxLength": 256,
          "title": "Model Ref",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ReasoningSelectionValue"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "supports_budget": {
          "title": "Supports Budget",
          "type": "boolean"
        }
      },
      "required": [
        "model_ref",
        "capability_revision",
        "available",
        "selection",
        "choices",
        "supports_budget",
        "budget_min",
        "budget_max",
        "stale"
      ],
      "title": "ReasoningView",
      "type": "object"
    },
    "ResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Binding Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "workspace",
            "artifact",
            "browser_session",
            "task",
            "document"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Revision",
          "type": "string"
        },
        "role": {
          "enum": [
            "context",
            "primary",
            "reference",
            "output"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "kind",
        "resource_id",
        "role",
        "revision"
      ],
      "title": "ResourceBinding",
      "type": "object"
    },
    "ResourceView": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "binding": {
          "$ref": "#/$defs/ResourceBinding"
        },
        "conversation_revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Conversation Revision",
          "type": "string"
        },
        "resource_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Resource Ref",
          "type": "string"
        },
        "resource_revision": {
          "maxLength": 128,
          "title": "Resource Revision",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "resource_ref",
        "conversation_revision",
        "binding",
        "title",
        "resource_revision",
        "available"
      ],
      "title": "ResourceView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionReadiness"
      },
      "maxItems": 6,
      "title": "Actions",
      "type": "array"
    },
    "context_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextUsageView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controls": {
      "$ref": "#/$defs/ConversationControls"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Conversation Id",
      "type": "string"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ProfileChoice"
      },
      "maxItems": 256,
      "title": "Profiles",
      "type": "array"
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasoningView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceView"
      },
      "maxItems": 200,
      "title": "Resources",
      "type": "array"
    },
    "revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Revision",
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "revision",
    "controls",
    "profiles",
    "resources",
    "actions"
  ],
  "title": "ConversationWorkspace",
  "type": "object"
}
