      "maxLength": 4096,
      "title": "Command",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Code"
    },
    "process_id": {
      "format": "uuid",
      "title": "Process Id",
      "type": "string"
    },
    "quiesced": {
      "title": "Quiesced",
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
