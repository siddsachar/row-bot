{
  "$defs": {
    "McpPluginTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "plugin",
          "title": "Kind",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "server_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Server Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "plugin_id",
        "server_key"
      ],
      "title": "McpPluginTarget",
      "type": "object"
    },
    "McpStandaloneTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "standalone",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "McpStandaloneTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_runtime_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Runtime Id"
    },
    "operation": {
      "enum": [
        "connect",
        "test",
        "disconnect"
      ],
      "title": "Operation",
      "type": "string"
    },
    "resource_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resource Revision",
      "type": "string"
    },
    "server_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Server Id",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpStandaloneTarget"
        },
        {
          "$ref": "#/$defs/McpPluginTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    }
  },
  "required": [
    "resource_revision",
    "server_id",
    "operation",
    "expected_runtime_id"
  ],
  "title": "McpRuntimeReviewRequest",
  "type": "object"
}
