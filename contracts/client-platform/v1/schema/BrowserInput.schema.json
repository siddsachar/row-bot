      "description": "The person's mouse, wheel or key in the pane, in the page's CSS pixels; ``copy`` reads the selection and\n``paste`` pastes text as the page's own paste.",
      "properties": {
        "action": {
          "default": "",
          "enum": [
            "move",
            "down",
            "up",
            "wheel",
            ""
          ],
          "title": "Action",
          "type": "string"
        },
        "button": {
          "default": "left",
          "enum": [
            "left",
            "right",
            "middle"
          ],
          "title": "Button",
          "type": "string"
        },
        "clicks": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Clicks",
          "type": "integer"
        },
        "dx": {
          "default": 0,
          "maximum": 100000,
          "minimum": -100000,
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "default": 0,
          "maximum": 100000,
          "minimum": -100000,
          "title": "Dy",
          "type": "number"
        },
        "key": {
          "default": "",
          "maxLength": 32,
          "title": "Key",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 65536,
          "title": "Text",
          "type": "string"
