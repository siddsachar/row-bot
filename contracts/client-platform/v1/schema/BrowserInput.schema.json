          "type": "string"
        },
        "x": {
          "default": 0,
          "maximum": 100000,
          "minimum": -10000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 100000,
          "minimum": -10000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "title": "BrowserInputEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
