{
  "$defs": {
    "ApprovalFolderChoice": {
      "additionalProperties": false,
      "description": "A registered code folder a folder card offers (never its path).",
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "default": "",
          "maxLength": 128,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "name"
      ],
      "title": "ApprovalFolderChoice",
      "type": "object"
    },
    "ApprovalQuestion": {
      "additionalProperties": false,
      "description": "One of Row-Bot's questions (N4): a header chip, the question and 2 to 4 options; \"Other\" is always offered.",
      "properties": {
        "header": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Header",
          "type": "string"
        },
        "multi_select": {
          "default": false,
          "title": "Multi Select",
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ApprovalQuestionOption"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "question": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "header",
        "question",
        "options"
      ],
      "title": "ApprovalQuestion",
      "type": "object"
    },
    "ApprovalQuestionOption": {
      "additionalProperties": false,
      "description": "One option of a question card; the recommended one carries its own tag.",
      "properties": {
        "description": {
          "default": "",
          "maxLength": 160,
          "title": "Description",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        }
      },
      "required": [
        "label"
      ],
      "title": "ApprovalQuestionOption",
      "type": "object"
    },
    "ApprovalSetup": {
      "additionalProperties": false,
      "description": "An approval that sets up something the work needs (a setup card).\n\n``tool`` turns a tool on; ``folder`` and ``clone`` pause the turn while\nthe person picks a code folder, or where to clone ``repo_url``, through\nAdd resource's picker and setup path (B277).",
      "properties": {
        "folders": {
          "items": {
            "$ref": "#/$defs/ApprovalFolderChoice"
          },
          "maxItems": 8,
          "title": "Folders",
          "type": "array"
        },
        "kind": {
          "enum": [
            "tool",
            "folder",
            "clone"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "repo_url": {
          "default": "",
          "maxLength": 2048,
          "title": "Repo Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "ApprovalSetup",
      "type": "object"
    },
    "SettingChange": {
      "additionalProperties": false,
      "description": "A change to one of Row-Bot's settings, in words: the row's name, where it is, what it was and becomes.",
      "properties": {
        "after": {
          "maxLength": 240,
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "before": {
          "default": "",
          "maxLength": 240,
          "title": "Before",
          "type": "string"
        },
        "href": {
          "default": "",
          "maxLength": 200,
          "pattern": "^(/settings/[A-Za-z0-9/?=&#._:-]{0,189})?$",
          "title": "Href",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "where": {
          "default": "",
          "maxLength": 200,
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "label",
        "after"
      ],
      "title": "SettingChange",
      "type": "object"
    },
    "TraceAppRef": {
      "additionalProperties": false,
      "description": "An app a Connect card offers, or the app behind a step or approval: its catalog id, name and logo,\nre-read from local data, and for a step the tool's readable title in that app (\"Delete page\").",
      "properties": {
        "allow_changes": {
          "default": false,
          "title": "Allow Changes",
          "type": "boolean"
        },
        "icon": {
          "maxLength": 128,
          "title": "Icon",
          "type": "string"
        },
        "item_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "tool": {
          "default": "",
          "maxLength": 128,
          "title": "Tool",
          "type": "string"
        },
        "view": {
          "default": false,
          "title": "View",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "name",
        "icon"
      ],
      "title": "TraceAppRef",
      "type": "object"
    },
    "XPostApproval": {
      "additionalProperties": false,
      "description": "What an X post's approval lets happen (N7); the approval is bound to every field of it.",
      "properties": {
        "account_id": {
          "pattern": "^[0-9]{1,20}$",
          "title": "Account Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "post",
            "reply",
            "quote",
            "delete"
          ],
          "title": "Action",
          "type": "string"
        },
        "limit": {
          "default": 0,
          "maximum": 25000,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/XPostMedia"
          },
          "maxItems": 4,
          "title": "Media",
          "type": "array"
        },
        "name": {
          "default": "",
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "post_at": {
          "default": "",
          "maxLength": 16,
          "pattern": "^(\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d)?$",
          "title": "Post At",
          "type": "string"
        },
        "target_id": {
          "default": "",
          "pattern": "^[0-9]{0,20}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_text": {
          "default": "",
          "maxLength": 25000,
          "title": "Target Text",
          "type": "string"
        },
        "target_url": {
          "default": "",
          "maxLength": 256,
          "pattern": "^(https://x\\.com/[A-Za-z0-9_]+/status/[0-9]+)?$",
          "title": "Target Url",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 25000,
          "title": "Text",
          "type": "string"
        },
        "username": {
          "pattern": "^[A-Za-z0-9_]{1,50}$",
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "username",
        "action"
      ],
      "title": "XPostApproval",
      "type": "object"
    },
    "XPostMedia": {
      "additionalProperties": false,
      "description": "A photo or video on an X post's card: its name, size, the start of its SHA-256 and a small picture.",
      "properties": {
        "kind": {
          "enum": [
            "image",
            "gif",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mime": {
          "default": "",
          "maxLength": 100,
          "pattern": "^([a-z]+/[a-z0-9.+-]+)?$",
          "title": "Mime",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ref": {
          "default": "",
          "maxLength": 256,
          "pattern": "^([A-Za-z0-9_-]+:[0-9a-f-]{36})?$",
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{12}$",
          "title": "Sha256",
          "type": "string"
        },
        "silent": {
          "default": false,
          "title": "Silent",
          "type": "boolean"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "thumbnail": {
          "default": "",
          "maxLength": 32768,
          "pattern": "^(data:image/jpeg;base64,[A-Za-z0-9+/=]+)?$",
          "title": "Thumbnail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "size",
        "sha256",
        "kind"
      ],
      "title": "XPostMedia",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_label": {
      "default": "Requested action",
      "maxLength": 180,
      "title": "Action Label",
      "type": "string"
    },
    "app": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceAppRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "folder": {
      "default": "",
      "maxLength": 120,
      "title": "Folder",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Id",
      "type": "string"
    },
    "memory_text": {
      "default": "",
      "maxLength": 4096,
      "title": "Memory Text",
      "type": "string"
    },
    "nonce": {
      "maxLength": 256,
      "minLength": 32,
      "title": "Nonce",
      "type": "string"
    },
    "policy_revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Policy Revision",
      "type": "string"
    },
    "question": {
      "default": "",
      "maxLength": 240,
      "title": "Question",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/ApprovalQuestion"
      },
      "maxItems": 4,
      "title": "Questions",
      "type": "array"
    },
    "reason": {
      "default": "",
      "maxLength": 1024,
      "title": "Reason",
      "type": "string"
    },
    "repeatable": {
      "default": false,
      "title": "Repeatable",
      "type": "boolean"
    },
    "requested_at": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested At"
    },
    "requesting_trace_id": {
      "default": "",
      "maxLength": 256,
      "title": "Requesting Trace Id",
      "type": "string"
    },
    "reviewer_reason": {
      "default": "",
      "maxLength": 240,
      "title": "Reviewer Reason",
      "type": "string"
    },
    "revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Revision",
      "type": "string"
    },
    "risk_class": {
      "default": "unknown",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ],
      "title": "Risk Class",
      "type": "string"
    },
    "safe_argument_summary": {
      "default": "",
      "maxLength": 1024,
      "title": "Safe Argument Summary",
      "type": "string"
    },
    "scope": {
      "default": "",
      "maxLength": 1024,
      "title": "Scope",
      "type": "string"
    },
    "setting_change": {
      "anyOf": [
        {
          "$ref": "#/$defs/SettingChange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalSetup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "const": "pending",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "x_post": {
      "anyOf": [
        {
          "$ref": "#/$defs/XPostApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "status",
    "revision",
    "policy_revision",
    "nonce"
  ],
  "title": "ApprovalView",
  "type": "object"
}
