{
  "$defs": {
    "ApprovalSetup": {
      "additionalProperties": false,
      "description": "An approval that turns on something the work needs (a setup card).",
      "properties": {
        "kind": {
          "const": "tool",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "ApprovalSetup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_label": {
      "default": "Requested action",
      "maxLength": 180,
      "title": "Action Label",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Id",
      "type": "string"
    },
    "nonce": {
      "maxLength": 256,
      "minLength": 32,
      "title": "Nonce",
      "type": "string"
    },
    "policy_revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Policy Revision",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 1024,
      "title": "Reason",
      "type": "string"
    },
    "requested_at": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested At"
    },
    "requesting_trace_id": {
      "default": "",
      "maxLength": 256,
      "title": "Requesting Trace Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Revision",
      "type": "string"
    },
    "risk_class": {
      "default": "unknown",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ],
      "title": "Risk Class",
      "type": "string"
    },
    "safe_argument_summary": {
      "default": "",
      "maxLength": 1024,
      "title": "Safe Argument Summary",
      "type": "string"
    },
    "scope": {
      "default": "",
      "maxLength": 1024,
      "title": "Scope",
      "type": "string"
    },
    "setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalSetup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "const": "pending",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    }
  },
  "required": [
    "id",
    "status",
    "revision",
    "policy_revision",
    "nonce"
  ],
  "title": "ApprovalView",
  "type": "object"
}
