{
  "$defs": {
    "ApprovalFolderChoice": {
      "additionalProperties": false,
      "description": "A registered code folder a folder card offers (never its path).",
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "default": "",
          "maxLength": 128,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "name"
      ],
      "title": "ApprovalFolderChoice",
      "type": "object"
    },
    "ApprovalSetup": {
      "additionalProperties": false,
      "description": "An approval that sets up something the work needs (a setup card).\n\n``tool`` turns a tool on; ``folder`` and ``clone`` pause the turn while\nthe person picks a code folder, or where to clone ``repo_url``, through\nAdd resource's picker and setup path (B277).",
      "properties": {
        "folders": {
          "items": {
            "$ref": "#/$defs/ApprovalFolderChoice"
          },
          "maxItems": 8,
          "title": "Folders",
          "type": "array"
        },
        "kind": {
          "enum": [
            "tool",
            "folder",
            "clone"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "repo_url": {
          "default": "",
          "maxLength": 2048,
          "title": "Repo Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "ApprovalSetup",
      "type": "object"
    },
    "TraceAppRef": {
      "additionalProperties": false,
      "description": "An app a Connect card offers, or the app behind a step or approval: its catalog id, name and logo,\nre-read from local data, and for a step the tool's readable title in that app (\"Delete page\").",
      "properties": {
        "icon": {
          "maxLength": 128,
          "title": "Icon",
          "type": "string"
        },
        "item_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "tool": {
          "default": "",
          "maxLength": 128,
          "title": "Tool",
          "type": "string"
        },
        "view": {
          "default": false,
          "title": "View",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "name",
        "icon"
      ],
      "title": "TraceAppRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_label": {
      "default": "Requested action",
      "maxLength": 180,
      "title": "Action Label",
      "type": "string"
    },
    "app": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceAppRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Id",
      "type": "string"
    },
    "nonce": {
      "maxLength": 256,
      "minLength": 32,
      "title": "Nonce",
      "type": "string"
    },
    "policy_revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Policy Revision",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 1024,
      "title": "Reason",
      "type": "string"
    },
    "repeatable": {
      "default": false,
      "title": "Repeatable",
      "type": "boolean"
    },
    "requested_at": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested At"
    },
    "requesting_trace_id": {
      "default": "",
      "maxLength": 256,
      "title": "Requesting Trace Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Revision",
      "type": "string"
    },
    "risk_class": {
      "default": "unknown",
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ],
      "title": "Risk Class",
      "type": "string"
    },
    "safe_argument_summary": {
      "default": "",
      "maxLength": 1024,
      "title": "Safe Argument Summary",
      "type": "string"
    },
    "scope": {
      "default": "",
      "maxLength": 1024,
      "title": "Scope",
      "type": "string"
    },
    "setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalSetup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "const": "pending",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    }
  },
  "required": [
    "id",
    "status",
    "revision",
    "policy_revision",
    "nonce"
  ],
  "title": "ApprovalView",
  "type": "object"
}
