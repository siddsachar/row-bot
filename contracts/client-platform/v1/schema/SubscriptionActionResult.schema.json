{
  "$defs": {
    "SubscriptionAccountSnapshot": {
      "additionalProperties": false,
      "properties": {
        "credential_storage": {
          "enum": [
            "durable",
            "session",
            "unknown"
          ],
          "title": "Credential Storage",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "has_recovery": {
          "title": "Has Recovery",
          "type": "boolean"
        },
        "provider_id": {
          "enum": [
            "codex",
            "claude_subscription",
            "xai_oauth"
          ],
          "title": "Provider Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "runtime_state": {
          "const": "unknown",
          "title": "Runtime State",
          "type": "string"
        },
        "saved_state": {
          "enum": [
            "disconnected",
            "saved",
            "metadata_only",
            "unavailable"
          ],
          "title": "Saved State",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "revision",
        "saved_state",
        "credential_storage",
        "has_recovery",
        "expires_at",
        "runtime_state"
      ],
      "title": "SubscriptionAccountSnapshot",
      "type": "object"
    },
    "SubscriptionAccountsSnapshot": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/SubscriptionAccountSnapshot"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Accounts",
          "type": "array"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "accounts"
      ],
      "title": "SubscriptionAccountsSnapshot",
      "type": "object"
    },
    "SubscriptionFlowSnapshot": {
      "additionalProperties": false,
      "properties": {
        "authorization_url": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authorization Url"
        },
        "device_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Code"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "flow_id": {
          "format": "uuid",
          "title": "Flow Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "device_code",
            "authorization_code",
            "loopback"
          ],
          "title": "Method",
          "type": "string"
        },
        "provider_id": {
          "enum": [
            "codex",
            "claude_subscription",
            "xai_oauth"
          ],
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Revision",
          "type": "string"
        },
        "quiescent": {
          "title": "Quiescent",
          "type": "boolean"
        },
        "server_epoch": {
          "format": "uuid",
          "title": "Server Epoch",
          "type": "string"
        },
        "state": {
          "enum": [
            "starting",
            "waiting",
            "checking",
            "exchanging",
            "publishing",
            "connected",
            "cancelled",
            "expired",
            "uncertain",
            "draining"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "flow_id",
        "server_epoch",
        "provider_id",
        "provider_revision",
        "state",
        "method",
        "authorization_url",
        "device_code",
        "expires_at",
        "quiescent"
      ],
      "title": "SubscriptionFlowSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "$ref": "#/$defs/SubscriptionAccountsSnapshot"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "flow": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubscriptionFlowSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "const": "completed",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "status",
    "accounts"
  ],
  "title": "SubscriptionActionResult",
  "type": "object"
}
