{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "inspect",
        "refine",
        "update",
        "create",
        "setup",
        "test",
        "enable",
        "promote",
        "remove"
      ],
      "title": "Action",
      "type": "string"
    },
    "client_session_id": {
      "format": "uuid",
      "title": "Client Session Id",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "folder_grant": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Folder Grant"
    },
    "payload": {
      "additionalProperties": true,
      "maxProperties": 8,
      "title": "Payload",
      "type": "object"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "client_session_id",
    "revision",
    "action"
  ],
  "title": "CustomToolLibraryCommand",
  "type": "object"
}
