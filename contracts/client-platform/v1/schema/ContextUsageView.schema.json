{
  "$defs": {
    "ContextBreakdown": {
      "additionalProperties": false,
      "description": "What fills the context after the last reply, in estimated tokens: counts only, no names.",
      "properties": {
        "conversation": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Conversation",
          "type": "integer"
        },
        "instructions": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Instructions",
          "type": "integer"
        },
        "memory": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Memory",
          "type": "integer"
        },
        "skills": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Skills",
          "type": "integer"
        },
        "tool_count": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Tool Count",
          "type": "integer"
        },
        "tools": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Tools",
          "type": "integer"
        }
      },
      "required": [
        "instructions",
        "tools",
        "skills",
        "memory",
        "conversation",
        "tool_count"
      ],
      "title": "ContextBreakdown",
      "type": "object"
    },
    "ConversationTokenUsage": {
      "additionalProperties": false,
      "description": "Tokens this conversation's model calls used, from the local ledger.",
      "properties": {
        "cache_read_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Percent"
        },
        "calls": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "last_cache_read_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Cache Read Percent"
        },
        "output_tokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens"
      ],
      "title": "ConversationTokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "breakdown": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextBreakdown"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capacity_state": {
      "default": "unavailable",
      "maxLength": 64,
      "title": "Capacity State",
      "type": "string"
    },
    "compact_at_tokens": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compact At Tokens"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Conversation Id",
      "type": "string"
    },
    "conversation_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConversationTokenUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "effective_limit_tokens": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective Limit Tokens"
    },
    "estimated_input_tokens": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Input Tokens"
    },
    "freshness": {
      "enum": [
        "unknown",
        "current",
        "stale"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "last_confirmed_input_tokens": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Confirmed Input Tokens"
    },
    "model_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Ref"
    },
    "native_window_tokens": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Window Tokens"
    },
    "scope": {
      "default": "unknown",
      "enum": [
        "agent",
        "chat_only",
        "unknown"
      ],
      "title": "Scope",
      "type": "string"
    },
    "state": {
      "enum": [
        "unknown",
        "saved",
        "live",
        "stale"
      ],
      "title": "State",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "compacting",
        "failed",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "usable_input_tokens": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usable Input Tokens"
    }
  },
  "required": [
    "conversation_id",
    "state",
    "freshness",
    "status"
  ],
  "title": "ContextUsageView",
  "type": "object"
}
