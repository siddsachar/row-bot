{
  "$defs": {
    "SkillHubEntryView": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "maxLength": 160,
          "title": "Author",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "title": "Id",
          "type": "string"
        },
        "installed": {
          "title": "Installed",
          "type": "boolean"
        },
        "name": {
          "maxLength": 160,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Tags",
          "type": "array"
        },
        "trust_level": {
          "maxLength": 80,
          "title": "Trust Level",
          "type": "string"
        },
        "url": {
          "default": "",
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "source",
        "author",
        "trust_level",
        "tags",
        "installed"
      ],
      "title": "SkillHubEntryView",
      "type": "object"
    },
    "SkillHubFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "title": "Path",
          "type": "string"
        },
        "severity": {
          "enum": [
            "block",
            "warn",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "path"
      ],
      "title": "SkillHubFinding",
      "type": "object"
    },
    "SkillHubInstalledRecord": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "file_count": {
          "minimum": 0,
          "title": "File Count",
          "type": "integer"
        },
        "installed_at": {
          "maxLength": 64,
          "title": "Installed At",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "title": "Source",
          "type": "string"
        },
        "updated_at": {
          "maxLength": 64,
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "enabled",
        "installed_at",
        "updated_at",
        "file_count",
        "revision"
      ],
      "title": "SkillHubInstalledRecord",
      "type": "object"
    },
    "SkillHubPreview": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "type": "string"
          },
          "maxItems": 300,
          "title": "Changes",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/SkillHubEntryView"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Files",
          "type": "array"
        },
        "preview_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Preview Id",
          "type": "string"
        },
        "primary_text": {
          "maxLength": 6000,
          "title": "Primary Text",
          "type": "string"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Provenance",
          "type": "array"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Requirements",
          "type": "array"
        },
        "review_files": {
          "items": {
            "$ref": "#/$defs/SkillHubReviewFile"
          },
          "maxItems": 100,
          "title": "Review Files",
          "type": "array"
        },
        "scan": {
          "$ref": "#/$defs/SkillHubScanView"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill_name": {
          "maxLength": 160,
          "title": "Skill Name",
          "type": "string"
        },
        "version": {
          "default": "",
          "maxLength": 256,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "preview_id",
        "content_hash",
        "entry",
        "skill_name",
        "primary_text",
        "files",
        "scan"
      ],
      "title": "SkillHubPreview",
      "type": "object"
    },
    "SkillHubReviewFile": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "title": "Executable",
          "type": "boolean"
        },
        "path": {
          "maxLength": 1024,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "unavailable_reason": {
          "default": "",
          "maxLength": 256,
          "title": "Unavailable Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "executable"
      ],
      "title": "SkillHubReviewFile",
      "type": "object"
    },
    "SkillHubScanView": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/SkillHubFinding"
          },
          "maxItems": 50,
          "title": "Findings",
          "type": "array"
        },
        "token_estimate": {
          "minimum": 0,
          "title": "Token Estimate",
          "type": "integer"
        }
      },
      "required": [
        "blocked",
        "findings",
        "token_estimate"
      ],
      "title": "SkillHubScanView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "check",
        "review_update",
        "update",
        "restore",
        "uninstall"
      ],
      "title": "Action",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "message": {
      "maxLength": 300,
      "title": "Message",
      "type": "string"
    },
    "record": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillHubInstalledRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "success": {
      "title": "Success",
      "type": "boolean"
    },
    "update_preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillHubPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "action",
    "success",
    "message",
    "record"
  ],
  "title": "SkillHubMaintenanceReceipt",
  "type": "object"
}
