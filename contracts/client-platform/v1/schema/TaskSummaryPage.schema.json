{
  "$defs": {
    "TaskSummary": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "At"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conversation Id"
        },
        "description": {
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "icon": {
          "maxLength": 32,
          "title": "Icon",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "last_run": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Run"
        },
        "last_status": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Status"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "notify_only": {
          "title": "Notify Only",
          "type": "boolean"
        },
        "schedule": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "icon",
        "enabled",
        "notify_only",
        "schedule",
        "at",
        "last_run",
        "last_status",
        "conversation_id"
      ],
      "title": "TaskSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TaskSummary"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "items",
    "total",
    "next_cursor"
  ],
  "title": "TaskSummaryPage",
  "type": "object"
}
