{
  "$defs": {
    "TaskActiveRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "started_at": {
          "maxLength": 80,
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "maxLength": 80,
          "title": "Status",
          "type": "string"
        },
        "steps_done": {
          "minimum": 0,
          "title": "Steps Done",
          "type": "integer"
        },
        "steps_total": {
          "minimum": 0,
          "title": "Steps Total",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "status",
        "started_at",
        "steps_done",
        "steps_total"
      ],
      "title": "TaskActiveRun",
      "type": "object"
    },
    "TaskRunDigest": {
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "maxLength": 80,
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "maxLength": 80,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "started_at"
      ],
      "title": "TaskRunDigest",
      "type": "object"
    },
    "TaskSummary": {
      "additionalProperties": false,
      "properties": {
        "active_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskActiveRun"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agent_profile_id": {
          "maxLength": 128,
          "title": "Agent Profile Id",
          "type": "string"
        },
        "approval_mode": {
          "maxLength": 64,
          "title": "Approval Mode",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "At"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conversation Id"
        },
        "description": {
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "icon": {
          "maxLength": 32,
          "title": "Icon",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "last_run": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Run"
        },
        "last_status": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Status"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "next_run": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Run"
        },
        "notify_only": {
          "title": "Notify Only",
          "type": "boolean"
        },
        "recent_runs": {
          "items": {
            "$ref": "#/$defs/TaskRunDigest"
          },
          "maxItems": 10,
          "title": "Recent Runs",
          "type": "array"
        },
        "schedule": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schedule"
        },
        "step_count": {
          "minimum": 0,
          "title": "Step Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "icon",
        "enabled",
        "notify_only",
        "step_count",
        "schedule",
        "at",
        "last_run",
        "last_status",
        "conversation_id",
        "agent_profile_id",
        "approval_mode"
      ],
      "title": "TaskSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/TaskSummary"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "items",
    "total",
    "next_cursor"
  ],
  "title": "TaskSummaryPage",
  "type": "object"
}
