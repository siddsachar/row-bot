{
  "additionalProperties": false,
  "properties": {
    "batch_ids": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Batch Ids"
    },
    "code": {
      "anyOf": [
        {
          "const": "document_outcome_uncertain",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "count": {
      "anyOf": [
        {
          "maximum": 50,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Count"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "paused",
            "resumed",
            "cancellation_requested",
            "retried",
            "cleared"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "retained_work": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retained Work"
    },
    "saved_status": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Saved Status"
    },
    "status": {
      "enum": [
        "completed",
        "rejected",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "DocumentControlReceipt",
  "type": "object"
}
