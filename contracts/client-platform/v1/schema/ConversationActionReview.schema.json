      "title": "Conversation Id",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Disclosures",
      "type": "array"
    },
    "fields": {
      "additionalProperties": true,
      "title": "Fields",
      "type": "object"
    },
    "review_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "summary": {
      "maxLength": 512,
      "title": "Summary",
      "type": "string"
    }
