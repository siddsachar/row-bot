{
  "$defs": {
    "AttachmentView": {
      "additionalProperties": false,
      "properties": {
        "attachment_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Attachment Ref",
          "type": "string"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "video/mp4",
            "application/pdf",
            "application/octet-stream"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Revision",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 26214400,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "attachment_ref",
        "name",
        "mime_type",
        "size_bytes",
        "revision"
      ],
      "title": "AttachmentView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "items": {
        "$ref": "#/$defs/AttachmentView"
      },
      "maxItems": 32,
      "title": "Attachments",
      "type": "array"
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Conversation Id",
      "type": "string"
    },
    "revision": {
      "maxLength": 128,
      "title": "Revision",
      "type": "string"
    },
    "text": {
      "maxLength": 200000,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "revision",
    "text",
    "attachments"
  ],
  "title": "DraftView",
  "type": "object"
}
