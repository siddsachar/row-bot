{
  "additionalProperties": false,
  "description": "A scene as the Video panel writes it (an empty id is a new scene).",
  "properties": {
    "card": {
      "default": "",
      "maxLength": 120,
      "title": "Card",
      "type": "string"
    },
    "end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "line": {
      "default": "",
      "maxLength": 300,
      "title": "Line",
      "type": "string"
    },
    "scene_id": {
      "default": "",
      "maxLength": 16,
      "pattern": "^(s[0-9a-f]{6})?$",
      "title": "Scene Id",
      "type": "string"
    },
    "source": {
      "default": "",
      "maxLength": 512,
      "title": "Source",
      "type": "string"
    },
    "speed": {
      "default": 1,
      "maximum": 4,
      "minimum": 0.25,
      "title": "Speed",
      "type": "number"
    },
    "start": {
      "default": 0,
      "minimum": 0,
      "title": "Start",
      "type": "number"
    },
    "zoom": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zoom"
    }
  },
  "title": "VideoSceneWrite",
  "type": "object"
}
