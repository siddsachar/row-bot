    "access": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanAccess"
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "items": {
        "enum": [
          "turn_off",
          "update",
          "remove"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "title": "Actions",
      "type": "array"
    },
    "destination": {
      "maxLength": 2048,
      "title": "Destination",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/IntegrationFile"
      },
      "maxItems": 100,
      "title": "Files",
      "type": "array"
    },
    "identifier": {
      "maxLength": 512,
      "title": "Identifier",
      "type": "string"
    },
    "license": {
      "maxLength": 256,
      "title": "License",
      "type": "string"
    },
    "package": {
      "maxLength": 256,
      "title": "Package",
      "type": "string"
    },
    "pin": {
      "maxLength": 128,
      "title": "Pin",
      "type": "string"
    },
    "profiles": {
      "items": {
        "maxLength": 80,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Profiles",
      "type": "array"
