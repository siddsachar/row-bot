      "title": "Runs Locally",
      "type": "boolean"
    },
    "saved_key": {
      "title": "Saved Key",
      "type": "boolean"
    },
    "settings": {
      "items": {
        "$ref": "#/$defs/PlanInput"
      },
      "maxItems": 32,
      "title": "Settings",
      "type": "array"
    },
    "signed_in": {
      "title": "Signed In",
      "type": "boolean"
    },
    "signs_in": {
      "title": "Signs In",
      "type": "boolean"
    },
    "source_url": {
      "maxLength": 2048,
      "title": "Source Url",
      "type": "string"
    },
    "views": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppViewsAbout"
