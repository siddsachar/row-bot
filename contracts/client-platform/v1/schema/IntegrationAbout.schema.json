      "additionalProperties": false,
      "properties": {
        "everywhere": {
          "title": "Everywhere",
          "type": "boolean"
        },
        "on": {
          "title": "On",
          "type": "boolean"
        }
      },
      "required": [
        "on",
        "everywhere"
      ],
      "title": "AppViewsAbout",
      "type": "object"
    },
    "IntegrationFile": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "title": "Executable",
          "type": "boolean"
        },
        "path": {
          "maxLength": 256,
          "title": "Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "executable"
      ],
      "title": "IntegrationFile",
      "type": "object"
    },
    "IntegrationRequirement": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "label": {
          "maxLength": 96,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "available"
      ],
      "title": "IntegrationRequirement",
      "type": "object"
    },
    "IntegrationWay": {
      "additionalProperties": false,
      "description": "One way to connect an app (a hosted endpoint, a local package, an account...), from local catalogs.",
      "properties": {
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "hosted_sign_in",
            "api_key",
            "hosted",
            "local",
            "",
            "built_in"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "maxLength": 160,
          "title": "Publisher",
          "type": "string"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "method",
        "verified",
        "publisher",
        "supported"
      ],
      "title": "IntegrationWay",
      "type": "object"
    },
    "PlanAccess": {
      "additionalProperties": false,
      "properties": {
        "limited": {
          "default": false,
          "title": "Limited",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "maxLength": 256,
          "title": "Note",
          "type": "string"
        },
        "preset": {
          "enum": [
            "read_only",
            "ask",
            "full",
            "custom"
          ],
          "title": "Preset",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/PlanTool"
          },
          "maxItems": 256,
          "title": "Tools",
          "type": "array"
        },
        "tools_digest": {
          "maxLength": 64,
          "title": "Tools Digest",
          "type": "string"
        }
      },
      "required": [
        "preset",
        "tools",
        "tools_digest"
      ],
      "title": "PlanAccess",
      "type": "object"
    },
    "PlanInput": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
