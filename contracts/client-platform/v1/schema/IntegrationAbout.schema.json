    "license",
    "source_url",
    "pin",
    "identifier",
    "destination",
    "runs_locally",
    "saved_key",
    "signs_in",
    "signed_in",
    "requirements",
    "access",
    "package",
    "files",
    "profiles",
    "actions"
  ],
  "title": "IntegrationAbout",
  "type": "object"
}
