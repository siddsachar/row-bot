          "maxLength": 128,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "title": "Label",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "saved": {
          "default": false,
          "title": "Saved",
          "type": "boolean"
        },
        "secret": {
          "title": "Secret",
          "type": "boolean"
        },
        "target": {
          "enum": [
            "header",
            "env",
            "argument",
            "url_variable"
          ],
          "title": "Target",
          "type": "string"
        },
        "template": {
          "maxLength": 256,
          "title": "Template",
          "type": "string"
        }
