      "type": "string"
    },
    "preview_id": {
      "default": "",
      "maxLength": 64,
      "title": "Preview Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    }
