{
  "$defs": {
    "ComputerUseSnapshot": {
      "additionalProperties": false,
      "description": "The conversation's computer-use card: plain state and what it can do.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "app": {
          "maxLength": 120,
          "title": "App",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Id"
        },
        "can_pause": {
          "title": "Can Pause",
          "type": "boolean"
        },
        "can_resume": {
          "title": "Can Resume",
          "type": "boolean"
        },
        "can_stop": {
          "title": "Can Stop",
          "type": "boolean"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "has_picture": {
          "title": "Has Picture",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "working",
            "paused",
            "waiting_approval",
            "needs_attention",
            "stopped"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "conversation_id",
        "revision",
        "active",
        "state",
        "app",
        "has_picture",
        "approval_id",
        "can_pause",
        "can_resume",
        "can_stop"
      ],
      "title": "ComputerUseSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "computer_use.stop",
        "computer_use.pause",
        "computer_use.resume"
      ],
      "title": "Action",
      "type": "string"
    },
    "code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Code"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "computer_use": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComputerUseSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Conversation Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "action",
    "conversation_id",
    "status",
    "code",
    "computer_use"
  ],
  "title": "ComputerUseReceipt",
  "type": "object"
}
