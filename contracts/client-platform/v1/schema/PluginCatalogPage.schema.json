{
  "$defs": {
    "PluginCapability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        }
      },
      "required": [
        "available",
        "code"
      ],
      "title": "PluginCapability",
      "type": "object"
    },
    "PluginCatalogItem": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": {
            "$ref": "#/$defs/PluginCapability"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "description": {
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "health": {
          "maxLength": 64,
          "title": "Health",
          "type": "string"
        },
        "installed": {
          "title": "Installed",
          "type": "boolean"
        },
        "manifest_revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Revision"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Permissions",
          "type": "array"
        },
        "plugin_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Plugin Id",
          "type": "string"
        },
        "provides": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Provides",
          "type": "object"
        },
        "setup_complete": {
          "title": "Setup Complete",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "installed",
            "marketplace"
          ],
          "title": "Source",
          "type": "string"
        },
        "update_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Update Version"
        },
        "version": {
          "maxLength": 64,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "name",
        "version",
        "description",
        "source",
        "installed",
        "enabled",
        "setup_complete",
        "health",
        "update_version",
        "permissions",
        "provides",
        "manifest_revision",
        "capabilities"
      ],
      "title": "PluginCatalogItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PluginCatalogItem"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "total": {
      "maximum": 2000,
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "availability",
    "items",
    "total",
    "next_cursor"
  ],
  "title": "PluginCatalogPage",
  "type": "object"
}
