      "title": "Resource Revision",
      "type": "string"
    },
    "runtime_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Runtime Id"
    },
    "server_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Server Id",
      "type": "string"
    }
  },
  "required": [
    "resource_revision",
    "server_id",
    "operation",
    "runtime_id",
    "action_digest",
    "nonce"
