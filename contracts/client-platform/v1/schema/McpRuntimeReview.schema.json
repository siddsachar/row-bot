      "maxLength": 128,
      "minLength": 1,
      "title": "Action Digest",
      "type": "string"
    },
    "nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Nonce",
      "type": "string"
    },
    "operation": {
      "enum": [
        "connect",
        "test",
        "disconnect"
      ],
      "title": "Operation",
      "type": "string"
    },
    "resource_revision": {
