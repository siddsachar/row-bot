      "type": "object"
    },
    "BuddySettingsSnapshot": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        },
        "bubble_options": {
          "items": {
            "$ref": "#/$defs/SettingsChoice"
          },
          "maxItems": 8,
          "title": "Bubble Options",
          "type": "array"
        },
        "bubble_verbosity": {
          "enum": [
            "quiet",
            "normal",
            "chatty"
          ],
          "title": "Bubble Verbosity",
          "type": "string"
        },
        "collapsed": {
          "title": "Collapsed",
          "type": "boolean"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "hatch_prompt": {
          "maxLength": 4096,
          "title": "Hatch Prompt",
          "type": "string"
        },
        "pack_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pack Id",
          "type": "string"
        },
        "packs": {
          "items": {
            "$ref": "#/$defs/BuddySettingsPack"
          },
          "maxItems": 128,
          "title": "Packs",
          "type": "array"
        },
        "personality": {
          "maxLength": 64,
          "title": "Personality",
          "type": "string"
        },
        "personality_description": {
          "maxLength": 200,
          "title": "Personality Description",
          "type": "string"
        },
        "personality_options": {
          "items": {
            "$ref": "#/$defs/SettingsChoice"
          },
          "maxItems": 16,
          "title": "Personality Options",
          "type": "array"
        },
        "placement": {
          "enum": [
            "docked",
            "desktop"
          ],
          "title": "Placement",
          "type": "string"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "availability",
        "enabled",
        "visible",
        "placement",
        "collapsed",
        "personality",
        "personality_description",
        "bubble_verbosity",
        "hatch_prompt",
        "pack_id",
        "personality_options",
        "bubble_options",
        "packs"
      ],
