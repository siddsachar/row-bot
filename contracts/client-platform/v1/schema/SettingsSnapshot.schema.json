{
  "$defs": {
    "AccountSettingsItem": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "enum": [
            "github",
            "gmail",
            "calendar",
            "x"
          ],
          "title": "Account Id",
          "type": "string"
        },
        "authentication_state": {
          "enum": [
            "not_configured",
            "not_authenticated",
            "configured_unchecked",
            "saved_unchecked",
            "expired",
            "unavailable"
          ],
          "title": "Authentication State",
          "type": "string"
        },
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "credential": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettingsCredentialState"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentials_path": {
          "maxLength": 4096,
          "title": "Credentials Path",
          "type": "string"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enabled"
        },
        "engage_operations": {
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Engage Operations",
          "type": "array"
        },
        "operations": {
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Operations",
          "type": "array"
        },
        "post_operations": {
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Post Operations",
          "type": "array"
        },
        "read_operations": {
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Read Operations",
          "type": "array"
        }
      },
      "required": [
        "account_id",
        "enabled",
        "configured",
        "authentication_state",
        "credentials_path",
        "credential",
        "operations",
        "read_operations",
        "post_operations",
        "engage_operations"
      ],
      "title": "AccountSettingsItem",
      "type": "object"
    },
    "AccountSettingsSnapshot": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        },
        "calendar": {
          "$ref": "#/$defs/AccountSettingsItem"
        },
        "github": {
          "$ref": "#/$defs/AccountSettingsItem"
        },
        "gmail": {
          "$ref": "#/$defs/AccountSettingsItem"
        },
        "x": {
          "$ref": "#/$defs/AccountSettingsItem"
        }
      },
      "required": [
        "availability",
        "github",
        "gmail",
        "calendar",
        "x"
      ],
      "title": "AccountSettingsSnapshot",
      "type": "object"
    },
    "BuddySettingsPack": {
      "additionalProperties": false,
