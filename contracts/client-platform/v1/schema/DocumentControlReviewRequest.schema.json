          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "revision"
      ],
      "title": "DocumentControlInput",
      "type": "object"
    },
    "DocumentControlTarget": {
      "additionalProperties": false,
      "properties": {
