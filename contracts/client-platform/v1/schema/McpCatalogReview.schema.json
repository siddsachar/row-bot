{
  "$defs": {
    "McpPluginTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "plugin",
          "title": "Kind",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "server_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Server Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "plugin_id",
        "server_key"
      ],
      "title": "McpPluginTarget",
      "type": "object"
    },
    "McpStandaloneTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "standalone",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "McpStandaloneTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "configuration_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Revision",
      "type": "string"
    },
    "nonce": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Nonce",
      "type": "string"
    },
    "operation": {
      "const": "accept_catalog",
      "title": "Operation",
      "type": "string"
    },
    "saved_disabled": {
      "title": "Saved Disabled",
      "type": "null"
    },
    "server_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Server Id",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpStandaloneTarget"
        },
        {
          "$ref": "#/$defs/McpPluginTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "test_command_id": {
      "format": "uuid",
      "title": "Test Command Id",
      "type": "string"
    },
    "tool_count": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Tool Count",
      "type": "integer"
    }
  },
  "required": [
    "configuration_revision",
    "server_id",
    "test_command_id",
    "operation",
    "action_digest",
    "tool_count",
    "saved_disabled",
    "nonce"
  ],
  "title": "McpCatalogReview",
  "type": "object"
}
