{
  "$defs": {
    "ProfileInstructionEdit": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "replace_only",
          "title": "Mode",
          "type": "string"
        },
        "stored": {
          "title": "Stored",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "stored"
      ],
      "title": "ProfileInstructionEdit",
      "type": "object"
    },
    "ProfileSummary": {
      "additionalProperties": false,
      "properties": {
        "allow_tools": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Allow Tools",
          "type": "array"
        },
        "approval_mode": {
          "enum": [
            "inherit",
            "block",
            "approve",
            "allow_all"
          ],
          "title": "Approval Mode",
          "type": "string"
        },
        "capability": {
          "enum": [
            "read_only",
            "write_capable",
            "orchestrator"
          ],
          "title": "Capability",
          "type": "string"
        },
        "context_mode": {
          "enum": [
            "auto",
            "focused",
            "recent",
            "full",
            "empty",
            "resume"
          ],
          "title": "Context Mode",
          "type": "string"
        },
        "description": {
          "maxLength": 1024,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "editable": {
          "title": "Editable",
          "type": "boolean"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "instruction_edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileInstructionEdit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "instructions_preview": {
          "const": "",
          "title": "Instructions Preview",
          "type": "string"
        },
        "instructions_truncated": {
          "title": "Instructions Truncated",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Revision",
          "type": "string"
        },
        "scope": {
          "enum": [
            "system",
            "user",
            "workspace",
            "plugin",
            "imported"
          ],
          "title": "Scope",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Skills",
          "type": "array"
        },
        "slug": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "title": "Source",
          "type": "string"
        },
        "surface_scope": {
          "const": "global",
          "title": "Surface Scope",
          "type": "string"
        },
        "when_to_use": {
          "maxLength": 1024,
          "title": "When To Use",
          "type": "string"
        },
        "workspace_mode": {
          "enum": [
            "auto",
            "read_only",
            "single_writer",
            "worktree"
          ],
          "title": "Workspace Mode",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "display_name",
        "description",
        "when_to_use",
        "scope",
        "surface_scope",
        "source",
        "enabled",
        "editable",
        "revision",
        "capability",
        "allow_tools",
        "skills",
        "context_mode",
        "workspace_mode",
        "approval_mode",
        "instructions_preview",
        "instructions_truncated"
      ],
      "title": "ProfileSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "enum": [
            "create",
            "edit",
            "duplicate",
            "delete",
            "enable",
            "disable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Id"
    },
    "status": {
      "enum": [
        "completed",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "ProfileReceipt",
  "type": "object"
}
