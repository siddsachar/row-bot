{
  "additionalProperties": false,
  "description": "Whether connected MCP servers' tools reach the chat (\"Enable in chat\", B130).",
  "properties": {
    "availability": {
      "enum": [
        "available",
        "missing",
        "registration_unavailable",
        "recovery_required",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "effective_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Enabled"
    },
    "registered": {
      "title": "Registered",
      "type": "boolean"
    },
    "resource_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resource Revision"
    },
    "saved_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Saved Enabled"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "resource_revision",
    "availability",
    "saved_enabled",
    "effective_enabled",
    "registered"
  ],
  "title": "McpChatState",
  "type": "object"
}
