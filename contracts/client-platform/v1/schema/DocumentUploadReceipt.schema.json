{
  "$defs": {
    "DocumentUploadedFile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "status": {
          "enum": [
            "queued",
            "skipped_duplicate"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "size_bytes",
        "id",
        "status"
      ],
      "title": "DocumentUploadedFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Batch Id"
    },
    "code": {
      "anyOf": [
        {
          "const": "document_upload_uncertain",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "files": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DocumentUploadedFile"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Files"
    },
    "processing": {
      "anyOf": [
        {
          "const": "paused",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Processing"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "DocumentUploadReceipt",
  "type": "object"
}
