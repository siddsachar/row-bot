      "title": "KnowledgeDeleteTarget",
      "type": "object"
    },
    "KnowledgeMaintenancePayload": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "pattern": "^[0-9a-f]{64}$",
