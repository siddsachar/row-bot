{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "plugin.enable",
        "plugin.disable",
        "plugin.configure",
        "plugin.test",
        "plugin.install",
        "plugin.update",
        "plugin.remove"
      ],
      "title": "Action",
      "type": "string"
    },
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "changes": {
      "additionalProperties": true,
      "title": "Changes",
      "type": "object"
    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Disclosures",
      "type": "array"
    },
    "plugin_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Plugin Id",
      "type": "string"
    },
    "review_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "plugin_id",
    "action",
    "revision",
    "action_digest",
    "changes",
    "disclosures",
    "review_id"
  ],
  "title": "PluginReview",
  "type": "object"
}
