{
  "$defs": {
    "SkillSummary": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Activation",
          "type": "object"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "description": {
          "maxLength": 1024,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "title": "Display Name",
          "type": "string"
        },
        "editable": {
          "title": "Editable",
          "type": "boolean"
        },
        "icon": {
          "maxLength": 32,
          "title": "Icon",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "instructions_preview": {
          "maxLength": 320,
          "title": "Instructions Preview",
          "type": "string"
        },
        "pinned": {
          "title": "Pinned",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "source": {
          "enum": [
            "user",
            "bundled"
          ],
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Tags",
          "type": "array"
        },
        "tool_guide": {
          "title": "Tool Guide",
          "type": "boolean"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "version": {
          "maxLength": 32,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "icon",
        "description",
        "source",
        "version",
        "tags",
        "activation",
        "available",
        "pinned",
        "editable",
        "tool_guide",
        "revision",
        "instructions_preview",
        "truncated"
      ],
      "title": "SkillSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "enum": [
        "available",
        "missing",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SkillSummary"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "total": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Total"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "availability",
    "items",
    "total",
    "next_cursor"
  ],
  "title": "SkillPage",
  "type": "object"
}
