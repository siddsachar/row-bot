{
  "$defs": {
    "GoalCheckClassification": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 64,
          "title": "Action",
          "type": "string"
        },
        "read_only": {
          "title": "Read Only",
          "type": "boolean"
        },
        "shell": {
          "enum": [
            "safe",
            "needs_approval",
            "private_data",
            "blocked"
          ],
          "title": "Shell",
          "type": "string"
        }
      },
      "required": [
        "shell",
        "action",
        "read_only"
      ],
      "title": "GoalCheckClassification",
      "type": "object"
    },
    "GoalCheckReview": {
      "additionalProperties": false,
      "description": "What the person approves with Confirm: this command, in this folder, at this level.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/GoalCheckClassification"
        },
        "command": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "level": {
          "enum": [
            "block",
            "approve",
            "auto",
            "full"
          ],
          "title": "Level",
          "type": "string"
        },
        "runs_in": {
          "maxLength": 300,
          "title": "Runs In",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "command",
        "workspace_id",
        "runs_in",
        "level",
        "classification"
      ],
      "title": "GoalCheckReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Action Digest",
      "type": "string"
    },
    "check": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalCheckReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "check_command": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Check Command"
    },
    "conversation_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Disclosures",
      "type": "array"
    },
    "done_means": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Done Means"
    },
    "goal_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Goal Id"
    },
    "max_minutes": {
      "anyOf": [
        {
          "maximum": 10080,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Minutes"
    },
    "max_turns": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Turns"
    },
    "objective": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Objective"
    },
    "operation": {
      "enum": [
        "start",
        "pause",
        "resume",
        "complete",
        "clear"
      ],
      "title": "Operation",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "review_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "revision": {
      "maxLength": 20,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "conversation_id",
    "goal_id",
    "revision",
    "operation",
    "objective",
    "max_turns",
    "reason",
    "schema_version",
    "action_digest",
    "disclosures",
    "review_id"
  ],
  "title": "GoalReview",
  "type": "object"
}
