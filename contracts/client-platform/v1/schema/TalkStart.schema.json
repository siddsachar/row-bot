{
  "$defs": {
    "ModelSelection": {
      "additionalProperties": false,
      "properties": {
        "model_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Ref",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "model_ref"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
    "WriteTarget": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Binding Id",
          "type": "string"
        },
        "binding_revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Binding Revision",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "workspace"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resource Revision",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "resource_id",
        "kind",
        "binding_revision",
        "resource_revision"
      ],
      "title": "WriteTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversation_revision": {
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "title": "Conversation Revision",
      "type": "string"
    },
    "model_selection": {
      "$ref": "#/$defs/ModelSelection"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "write_targets": {
      "items": {
        "$ref": "#/$defs/WriteTarget"
      },
      "maxItems": 2,
      "title": "Write Targets",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "conversation_revision",
    "model_selection",
    "write_targets"
  ],
  "title": "TalkStart",
  "type": "object"
}
