{
  "$defs": {
    "AttachmentBlock": {
      "additionalProperties": false,
      "properties": {
        "attachment_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Attachment Ref",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "name": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Revision",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 26214400,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "type": {
          "const": "attachment",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "attachment_ref",
        "name",
        "mime_type",
        "size_bytes",
        "revision"
      ],
      "title": "AttachmentBlock",
      "type": "object"
    },
    "ChartBlock": {
      "additionalProperties": false,
      "properties": {
        "figure_json": {
          "maxLength": 131072,
          "title": "Figure Json",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "chart",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "figure_json",
        "text"
      ],
      "title": "ChartBlock",
      "type": "object"
    },
    "GenerationState": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Id"
        },
        "can_stop": {
          "title": "Can Stop",
          "type": "boolean"
        },
        "cancel_requested": {
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "cleanup_complete": {
          "title": "Cleanup Complete",
          "type": "boolean"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Execution Id",
          "type": "string"
        },
        "external_outcome": {
          "enum": [
            "known_not_sent",
            "sent",
            "uncertain",
            "not_applicable"
          ],
          "title": "External Outcome",
          "type": "string"
        },
        "generation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Generation Id",
          "type": "string"
        },
        "pass_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Pass Id",
          "type": "string"
        },
        "quiesced": {
          "title": "Quiesced",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Revision",
          "type": "string"
        },
        "segment_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        },
        "status": {
          "enum": [
            "running",
            "stopping",
            "stopped",
            "waiting_approval",
            "completed",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "conversation_id",
        "generation_id",
        "pass_id",
        "status",
        "revision",
        "cancel_requested",
        "quiesced",
        "cleanup_complete",
        "external_outcome",
        "approval_id",
        "can_stop"
      ],
      "title": "GenerationState",
      "type": "object"
    },
    "MarkdownBlock": {
