          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "display_name",
