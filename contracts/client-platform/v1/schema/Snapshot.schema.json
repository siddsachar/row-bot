    "TraceSpecialization": {
      "additionalProperties": false,
      "properties": {
        "agent_runs": {
          "items": {
            "$ref": "#/$defs/TraceAgentReference"
          },
          "maxItems": 16,
          "title": "Agent Runs",
          "type": "array"
        },
        "display_name": {
          "default": "",
          "maxLength": 180,
          "title": "Display Name",
          "type": "string"
        },
        "error_code": {
          "default": "",
          "maxLength": 80,
          "title": "Error Code",
          "type": "string"
        },
        "evicted_skill_id": {
          "default": "",
          "maxLength": 180,
          "title": "Evicted Skill Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "skill_load",
            "delegated_agent",
            "media"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/TraceMediaReference"
          },
          "maxItems": 8,
          "title": "Media",
          "type": "array"
        },
        "media_kind": {
          "default": "",
          "maxLength": 64,
          "title": "Media Kind",
          "type": "string"
        },
        "newly_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Newly Active"
        },
        "skill_id": {
          "default": "",
          "maxLength": 180,
          "title": "Skill Id",
          "type": "string"
        },
        "source": {
          "default": "",
          "maxLength": 180,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TraceSpecialization",
      "type": "object"
    },
    "TranscriptRow": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "attachment": "#/$defs/AttachmentBlock",
                "chart": "#/$defs/ChartBlock",
                "markdown": "#/$defs/MarkdownBlock",
                "mermaid": "#/$defs/MermaidBlock",
                "text": "#/$defs/TextBlock",
                "youtube": "#/$defs/YouTubeBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextBlock"
              },
              {
                "$ref": "#/$defs/MarkdownBlock"
              },
              {
                "$ref": "#/$defs/MermaidBlock"
              },
              {
                "$ref": "#/$defs/ChartBlock"
              },
              {
                "$ref": "#/$defs/YouTubeBlock"
              },
              {
                "$ref": "#/$defs/AttachmentBlock"
              }
            ]
          },
          "maxItems": 256,
          "title": "Blocks",
          "type": "array"
        },
        "content_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Ref"
        },
        "content_status": {
          "anyOf": [
            {
              "enum": [
                "inline",
                "lazy",
                "oversized"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Status"
        },
        "id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "render_revision": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Render Revision"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "default": "",
          "maxLength": 256,
          "title": "Tool Call Id",
          "type": "string"
        },
        "tool_call_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Tool Call Ids",
          "type": "array"
        },
        "tool_calls_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls Ref"
        },
        "trace_parent_id": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Parent Id"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/TranscriptTraceGroup"
          },
          "maxItems": 256,
          "title": "Traces",
          "type": "array"
        }
      },
      "required": [
        "id",
        "role",
        "blocks"
      ],
      "title": "TranscriptRow",
      "type": "object"
    },
    "TranscriptTraceGroup": {
      "additionalProperties": false,
