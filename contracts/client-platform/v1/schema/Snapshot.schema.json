        "status": {
          "enum": [
            "pending",
            "succeeded",
            "failed",
            "blocked",
            "cancelled",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "name",
        "kind",
        "group_order",
        "status",
        "items",
        "counts"
      ],
      "title": "TranscriptTraceGroup",
      "type": "object"
    },
