{
  "$defs": {
    "ClaudePlanStatus": {
      "additionalProperties": false,
      "description": "Claude Code on the computer running Row-Bot: never a credential, a path or an account name.",
      "properties": {
        "detail": {
          "maxLength": 256,
          "title": "Detail",
          "type": "string"
        },
        "minimum_version": {
          "maxLength": 40,
          "title": "Minimum Version",
          "type": "string"
        },
        "plan": {
          "maxLength": 80,
          "title": "Plan",
          "type": "string"
        },
        "set_up_again": {
          "title": "Set Up Again",
          "type": "boolean"
        },
        "signed_in_before": {
          "default": false,
          "title": "Signed In Before",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "not_installed",
            "signed_out",
            "too_old",
            "ready",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "version": {
          "maxLength": 40,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "state",
        "version",
        "minimum_version",
        "plan",
        "detail",
        "set_up_again"
      ],
      "title": "ClaudePlanStatus",
      "type": "object"
    },
    "NativeTerminalFrame": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "maxLength": 16384,
          "title": "Data",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "data"
      ],
      "title": "NativeTerminalFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What Claude's sign-in printed since ``cursor``, carried as it is; then how it ended.",
  "properties": {
    "cursor": {
      "minimum": 0,
      "title": "Cursor",
      "type": "integer"
    },
    "ended": {
      "anyOf": [
        {
          "enum": [
            "exited",
            "closed",
            "idle",
            "replaced"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/NativeTerminalFrame"
      },
      "maxItems": 16,
      "title": "Frames",
      "type": "array"
    },
    "latest": {
      "minimum": 0,
      "title": "Latest",
      "type": "integer"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaudePlanStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "enum": [
        "running",
        "ended"
      ],
      "title": "Status",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "cursor",
    "latest",
    "truncated",
    "frames",
    "status"
  ],
  "title": "ClaudeSignInOutput",
  "type": "object"
}
