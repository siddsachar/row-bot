{
  "$defs": {
    "LearningChannelNote": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "maxLength": 64,
          "title": "Channel",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "maxLength": 256,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "name",
        "note"
      ],
      "title": "LearningChannelNote",
      "type": "object"
    },
    "LearningData": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "exists": {
          "title": "Exists",
          "type": "boolean"
        }
      },
      "required": [
        "exists",
        "bytes"
      ],
      "title": "LearningData",
      "type": "object"
    },
    "LearningDownload": {
      "additionalProperties": false,
      "description": "The personal model's download (L2b): the training engine, then the starting model.",
      "properties": {
        "done_bytes": {
          "minimum": 0,
          "title": "Done Bytes",
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "network",
                "mismatch",
                "install_failed",
                "check_failed",
                "no_cuda",
                "refused"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "free_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Bytes"
        },
        "needs_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needs Bytes"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "engine",
                "installing",
                "checking",
                "model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "state": {
          "enum": [
            "none",
            "ready",
            "downloading",
            "paused",
            "not_enough_disk",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "total_bytes": {
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "state",
        "done_bytes",
        "total_bytes"
      ],
      "title": "LearningDownload",
      "type": "object"
    },
    "LearningExamples": {
      "additionalProperties": false,
      "description": "How much of the person's work training can use (L2c): \"Needs more examples\" below ``needed``.",
      "properties": {
        "examples": {
          "minimum": 0,
          "title": "Examples",
          "type": "integer"
        },
        "left_out": {
          "minimum": 0,
          "title": "Left Out",
          "type": "integer"
        },
        "needed": {
          "minimum": 1,
          "title": "Needed",
          "type": "integer"
        },
        "new_examples": {
          "minimum": 0,
          "title": "New Examples",
          "type": "integer"
        }
      },
      "required": [
        "examples",
        "needed",
        "new_examples",
        "left_out"
      ],
      "title": "LearningExamples",
      "type": "object"
    },
    "LearningPastChats": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "state": {
          "enum": [
            "none",
            "reading",
            "waiting",
            "stopped",
            "done",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "state",
        "total",
        "done"
      ],
      "title": "LearningPastChats",
      "type": "object"
    },
    "LearningPersonalModel": {
      "additionalProperties": false,
      "properties": {
        "download": {
          "enum": [
            "not_asked",
            "waiting",
            "not_now"
          ],
          "title": "Download",
          "type": "string"
        },
        "download_state": {
          "$ref": "#/$defs/LearningDownload"
        },
        "engine": {
          "enum": [
            "not_downloaded",
            "installed",
            "damaged",
            "outdated"
          ],
          "title": "Engine",
          "type": "string"
        },
        "engine_bytes": {
          "minimum": 0,
          "title": "Engine Bytes",
          "type": "integer"
        },
        "engine_download_bytes": {
          "minimum": 0,
          "title": "Engine Download Bytes",
          "type": "integer"
        },
        "examples": {
          "anyOf": [
            {
              "$ref": "#/$defs/LearningExamples"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime": {
          "default": "ollama",
          "enum": [
            "ollama",
            "lmstudio",
            "llama_cpp",
            "vllm"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "runtimes": {
          "items": {
            "$ref": "#/$defs/LearningRuntime"
          },
          "maxItems": 8,
          "title": "Runtimes",
          "type": "array"
        },
        "starting_model": {
          "$ref": "#/$defs/LearningStartingModel"
        },
        "starting_model_bytes": {
          "minimum": 0,
          "title": "Starting Model Bytes",
          "type": "integer"
        },
        "starting_model_state": {
          "enum": [
            "not_downloaded",
            "downloaded",
            "damaged"
          ],
          "title": "Starting Model State",
          "type": "string"
        },
        "train_in_quiet_hours": {
          "title": "Train In Quiet Hours",
          "type": "boolean"
        },
        "train_where": {
          "enum": [
            "this_computer",
            "hugging_face"
          ],
          "title": "Train Where",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/LearningVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "train_in_quiet_hours",
        "train_where",
        "starting_model",
        "download",
        "engine",
        "engine_bytes",
        "engine_download_bytes",
        "starting_model_state",
        "starting_model_bytes",
        "download_state"
      ],
      "title": "LearningPersonalModel",
      "type": "object"
    },
    "LearningQuietHours": {
      "additionalProperties": false,
      "properties": {
        "next_look_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Look At"
        },
        "window_end": {
          "maximum": 23,
          "minimum": 0,
          "title": "Window End",
          "type": "integer"
        },
        "window_start": {
          "maximum": 23,
          "minimum": 0,
          "title": "Window Start",
          "type": "integer"
        }
      },
      "required": [
        "window_start",
        "window_end"
      ],
      "title": "LearningQuietHours",
      "type": "object"
    },
    "LearningRunnerStatus": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "enum": [
                "train_off",
                "hugging_face",
                "no_engine",
                "no_data",
                "quiet_hours",
                "after_dream",
                "now",
                "in_use",
                "chat",
                "workflow",
                "indexing",
                "dream",
                "you",
                "app_closed",
                "worker_stopped",
                "out_of_gpu_memory",
                "out_of_disk",
                "cannot_resume",
                "data_unreadable",
                "engine_error",
                "learning_off",
                "learning_paused",
                "extraction",
                "planned",
                "planning",
                "up_to_date",
                "gpu_busy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "off",
            "paused",
            "training",
            "waiting",
            "scheduled",
            "held",
            "failed",
            "trained",
            "nothing_to_do"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "LearningRunnerStatus",
      "type": "object"
    },
    "LearningRuntime": {
      "additionalProperties": false,
      "description": "Where a personal model can run (\"Runs in\", D10).",
      "properties": {
        "automated": {
          "title": "Automated",
          "type": "boolean"
        },
        "id": {
          "enum": [
            "ollama",
            "lmstudio",
            "llama_cpp",
            "vllm"
          ],
          "title": "Id",
          "type": "string"
        },
        "installed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installed"
        },
        "name": {
          "maxLength": 64,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "automated"
      ],
      "title": "LearningRuntime",
      "type": "object"
    },
    "LearningSnapshot": {
      "additionalProperties": false,
      "properties": {
        "apply_mode": {
          "enum": [
            "ask_first",
            "automatic"
          ],
          "title": "Apply Mode",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/LearningData"
        },
        "opted_out_conversations": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Opted Out Conversations",
          "type": "array"
        },
        "owner_unset_channels": {
          "items": {
            "$ref": "#/$defs/LearningChannelNote"
          },
          "maxItems": 8,
          "title": "Owner Unset Channels",
          "type": "array"
        },
        "past_chats": {
          "$ref": "#/$defs/LearningPastChats"
        },
        "personal_model": {
          "$ref": "#/$defs/LearningPersonalModel"
        },
        "quiet_hours": {
          "$ref": "#/$defs/LearningQuietHours"
        },
        "readable": {
          "title": "Readable",
          "type": "boolean"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sources": {
          "$ref": "#/$defs/LearningSourcesSnapshot"
        },
        "spending": {
          "$ref": "#/$defs/LearningSpending"
        },
        "state": {
          "enum": [
            "off",
            "on",
            "paused"
          ],
          "title": "State",
          "type": "string"
        },
        "training": {
          "$ref": "#/$defs/LearningTraining"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "state",
        "readable",
        "sources",
        "apply_mode",
        "spending",
        "quiet_hours",
        "past_chats",
        "personal_model",
        "training",
        "data",
        "opted_out_conversations",
        "owner_unset_channels"
      ],
      "title": "LearningSnapshot",
      "type": "object"
    },
    "LearningSourcesSnapshot": {
      "additionalProperties": false,
      "properties": {
        "my_chats": {
          "title": "My Chats",
          "type": "boolean"
        },
        "past_chats": {
          "title": "Past Chats",
          "type": "boolean"
        },
        "workflows_and_goals": {
          "title": "Workflows And Goals",
          "type": "boolean"
        }
      },
      "required": [
        "my_chats",
        "workflows_and_goals",
        "past_chats"
      ],
      "title": "LearningSourcesSnapshot",
      "type": "object"
    },
    "LearningSpending": {
      "additionalProperties": false,
      "properties": {
        "limit_reached": {
          "title": "Limit Reached",
          "type": "boolean"
        },
        "limit_tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Limit Tokens",
          "type": "integer"
        },
        "model_name": {
          "maxLength": 256,
          "title": "Model Name",
          "type": "string"
        },
        "resets_on": {
          "maxLength": 16,
          "title": "Resets On",
          "type": "string"
        },
        "used_tokens": {
          "minimum": 0,
          "title": "Used Tokens",
          "type": "integer"
        }
      },
      "required": [
        "used_tokens",
        "limit_tokens",
        "resets_on",
        "model_name",
        "limit_reached"
      ],
      "title": "LearningSpending",
      "type": "object"
    },
    "LearningStartingModel": {
      "additionalProperties": false,
      "properties": {
        "download_bytes": {
          "minimum": 0,
          "title": "Download Bytes",
          "type": "integer"
        },
        "id": {
          "maxLength": 64,
          "title": "Id",
          "type": "string"
        },
        "licence": {
          "maxLength": 64,
          "title": "Licence",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "licence",
        "download_bytes"
      ],
      "title": "LearningStartingModel",
      "type": "object"
    },
    "LearningTraining": {
      "additionalProperties": false,
      "description": "The personal model's current training run (L2a), polled while it runs.",
      "properties": {
        "can_train_now": {
          "title": "Can Train Now",
          "type": "boolean"
        },
        "checkpoint_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Step"
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "out_of_gpu_memory",
                "out_of_disk",
                "cannot_resume",
                "data_unreadable",
                "engine_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "job_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "pause_reason": {
          "anyOf": [
            {
              "enum": [
                "in_use",
                "local_gpu",
                "learning_paused",
                "learning_off",
                "you",
                "app_closed",
                "worker_stopped"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pause Reason"
        },
        "recovered": {
          "anyOf": [
            {
              "enum": [
                "previous_checkpoint",
                "start_over"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovered"
        },
        "resumes": {
          "anyOf": [
            {
              "enum": [
                "quiet_hours",
                "when_free",
                "ask"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resumes"
        },
        "runner": {
          "$ref": "#/$defs/LearningRunnerStatus"
        },
        "seconds_left": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds Left"
        },
        "state": {
          "enum": [
            "none",
            "planned",
            "waiting",
            "preparing",
            "running",
            "pausing",
            "paused",
            "evaluating",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "steps_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps Total"
        },
        "trigger": {
          "anyOf": [
            {
              "enum": [
                "quiet_hours",
                "train_now"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "state",
        "step",
        "can_train_now",
        "runner"
      ],
      "title": "LearningTraining",
      "type": "object"
    },
    "LearningVersion": {
      "additionalProperties": false,
      "description": "The newest personal-model version after training (L2c): being prepared to run, made ready in\nits runtime, ready (it then waits for its comparison), or stuck with the way out.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "examples": {
          "minimum": 0,
          "title": "Examples",
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "enum": [
                "not_enough_disk",
                "adapter_missing",
                "engine_missing",
                "tools_missing",
                "export_failed",
                "not_installed",
                "not_running",
                "not_local",
                "create_failed",
                "not_loaded",
                "probe_failed",
                "tool_turn_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "file_bytes": {
          "minimum": 0,
          "title": "File Bytes",
          "type": "integer"
        },
        "file_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Name"
        },
        "folder": {
          "maxLength": 1024,
          "title": "Folder",
          "type": "string"
        },
        "free_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Bytes"
        },
        "needs_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needs Bytes"
        },
        "phase": {
          "enum": [
            "exporting",
            "export_failed",
            "making_ready",
            "ready",
            "runtime_failed",
            "waiting_for_you"
          ],
          "title": "Phase",
          "type": "string"
        },
        "quantization": {
          "enum": [
            "Q8_0",
            "Q4_K_M"
          ],
          "title": "Quantization",
          "type": "string"
        },
        "runtime": {
          "enum": [
            "ollama",
            "lmstudio",
            "llama_cpp",
            "vllm"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "enum": [
                "merge",
                "convert",
                "quantize"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "trained_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trained At"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "phase",
        "runtime",
        "quantization",
        "file_bytes",
        "folder",
        "examples"
      ],
      "title": "LearningVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "signal_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signal Id"
    },
    "snapshot": {
      "$ref": "#/$defs/LearningSnapshot"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "uncertain"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "maxLength": 1024,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "status",
    "summary",
    "snapshot"
  ],
  "title": "LearningReceipt",
  "type": "object"
}
