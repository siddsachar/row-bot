{
  "additionalProperties": false,
  "properties": {
    "code": {
      "anyOf": [
        {
          "enum": [
            "relation_changed_or_invalid",
            "knowledge_outcome_uncertain"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "entity_ids": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Ids"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "saved",
            "removed",
            "superseded"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "projection_state": {
      "anyOf": [
        {
          "enum": [
            "pending",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projection State"
    },
    "relation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relation Id"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "KnowledgeRelationReceipt",
  "type": "object"
}
