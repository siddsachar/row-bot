{
  "$defs": {
    "DictationHandle": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "server_epoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Server Epoch",
          "type": "string"
        },
        "voice_session_id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Voice Session Id",
          "type": "integer"
        }
      },
      "required": [
        "voice_session_id",
        "server_epoch",
        "lease_id",
        "conversation_id"
      ],
      "title": "DictationHandle",
      "type": "object"
    },
    "TalkSnapshot": {
      "additionalProperties": false,
      "properties": {
        "expires_in_ms": {
          "maximum": 120000,
          "minimum": 0,
          "title": "Expires In Ms",
          "type": "integer"
        },
        "handle": {
          "$ref": "#/$defs/DictationHandle"
        },
        "max_audio_bytes": {
          "const": 8388608,
          "title": "Max Audio Bytes",
          "type": "integer"
        },
        "max_utterance_ms": {
          "const": 30000,
          "title": "Max Utterance Ms",
          "type": "integer"
        },
        "quiesced": {
          "title": "Quiesced",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "listening",
            "receiving",
            "transcribing",
            "thinking",
            "speaking",
            "stopping",
            "stopped"
          ],
          "title": "State",
          "type": "string"
        },
        "transport": {
          "const": "browser_local",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "handle",
        "state",
        "quiesced",
        "expires_in_ms",
        "run_id",
        "transport",
        "max_audio_bytes",
        "max_utterance_ms"
      ],
      "title": "TalkSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "enum": [
        "submitted",
        "no_speech"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "snapshot": {
      "$ref": "#/$defs/TalkSnapshot"
    },
    "text": {
      "maxLength": 4000,
      "title": "Text",
      "type": "string"
    },
    "utterance_id": {
      "format": "uuid",
      "title": "Utterance Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot",
    "utterance_id",
    "outcome",
    "text",
    "run_id"
  ],
  "title": "TalkResult",
  "type": "object"
}
