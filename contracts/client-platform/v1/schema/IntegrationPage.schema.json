{
  "$defs": {
    "IntegrationAttribution": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 512,
          "title": "Item Id",
          "type": "string"
        },
        "pin": {
          "maxLength": 128,
          "title": "Pin",
          "type": "string"
        },
        "publisher": {
          "maxLength": 160,
          "title": "Publisher",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "title": "Source",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "item_id",
        "url",
        "publisher",
        "version",
        "pin"
      ],
      "title": "IntegrationAttribution",
      "type": "object"
    },
    "IntegrationItem": {
      "additionalProperties": false,
      "properties": {
        "account_label": {
          "maxLength": 128,
          "title": "Account Label",
          "type": "string"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Actions",
          "type": "array"
        },
        "attributions": {
          "items": {
            "$ref": "#/$defs/IntegrationAttribution"
          },
          "maxItems": 512,
          "title": "Attributions",
          "type": "array"
        },
        "auth_requirement": {
          "default": "unknown",
          "enum": [
            "unknown",
            "required",
            "none"
          ],
          "title": "Auth Requirement",
          "type": "string"
        },
        "auth_status": {
          "enum": [
            "none",
            "configured",
            "expired"
          ],
          "title": "Auth Status",
          "type": "string"
        },
        "canonical_identity": {
          "default": "",
          "maxLength": 1024,
          "title": "Canonical Identity",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/IntegrationItem"
          },
          "maxItems": 256,
          "title": "Children",
          "type": "array"
        },
        "compatibility": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "not_inspected"
          ],
          "title": "Compatibility",
          "type": "string"
        },
        "description": {
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "evidence": {
          "maxLength": 512,
          "title": "Evidence",
          "type": "string"
        },
        "evidence_stage": {
          "default": "listed",
          "enum": [
            "listed",
            "inspected"
          ],
          "title": "Evidence Stage",
          "type": "string"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "installed": {
          "title": "Installed",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "skill",
            "mcp",
            "plugin"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "maxLength": 256,
          "title": "License",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "owner_ref": {
          "maxLength": 256,
          "title": "Owner Ref",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "pin": {
          "maxLength": 128,
          "title": "Pin",
          "type": "string"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Platforms",
          "type": "array"
        },
        "publisher": {
          "maxLength": 160,
          "title": "Publisher",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reasons",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "revision": {
          "maxLength": 128,
          "title": "Revision",
          "type": "string"
        },
        "setup": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationSetup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "maxLength": 80,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "maxLength": 2048,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "off",
            "setup",
            "attention",
            "missing_runtime",
            "disconnected",
            "retained",
            "recovery",
            "discover"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpStandaloneTarget"
            },
            {
              "$ref": "#/$defs/McpPluginTarget"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "tested_with_row_bot": {
          "default": false,
          "title": "Tested With Row Bot",
          "type": "boolean"
        },
        "version": {
          "maxLength": 128,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "owner_ref",
        "parent_id",
        "name",
        "description",
        "source",
        "publisher",
        "source_url",
        "version",
        "pin",
        "license",
        "compatibility",
        "reasons",
        "platforms",
        "evidence",
        "installed",
        "enabled",
        "status",
        "revision",
        "actions",
        "auth_status",
        "account_label",
        "children",
        "target"
      ],
      "title": "IntegrationItem",
      "type": "object"
    },
    "IntegrationSecretBinding": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 64,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "header",
            "env"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "enum": [
            "",
            "Bearer ",
            "Basic "
          ],
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "key"
      ],
      "title": "IntegrationSecretBinding",
      "type": "object"
    },
    "IntegrationSetup": {
      "additionalProperties": false,
      "properties": {
        "account_requirements": {
          "maxLength": 512,
          "title": "Account Requirements",
          "type": "string"
        },
        "auth_mode": {
          "enum": [
            "none",
            "oauth",
            "api_key",
            "unknown",
            "unsupported"
          ],
          "title": "Auth Mode",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/IntegrationSecretBinding"
          },
          "maxItems": 16,
          "title": "Bindings",
          "type": "array"
        },
        "catalog_accepted": {
          "title": "Catalog Accepted",
          "type": "boolean"
        },
        "cost": {
          "maxLength": 512,
          "title": "Cost",
          "type": "string"
        },
        "credential_configured": {
          "title": "Credential Configured",
          "type": "boolean"
        },
        "destination": {
          "maxLength": 2048,
          "title": "Destination",
          "type": "string"
        },
        "evidence": {
          "maxLength": 512,
          "title": "Evidence",
          "type": "string"
        },
        "execution": {
          "enum": [
            "local",
            "hosted"
          ],
          "title": "Execution",
          "type": "string"
        },
        "package_prepared": {
          "title": "Package Prepared",
          "type": "boolean"
        },
        "package_required": {
          "title": "Package Required",
          "type": "boolean"
        },
        "requirements": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 8,
          "title": "Requirements",
          "type": "array"
        },
        "runtime_status": {
          "maxLength": 64,
          "title": "Runtime Status",
          "type": "string"
        }
      },
      "required": [
        "auth_mode",
        "execution",
        "destination",
        "bindings",
        "credential_configured",
        "catalog_accepted",
        "requirements",
        "runtime_status",
        "package_prepared",
        "package_required",
        "account_requirements",
        "cost",
        "evidence"
      ],
      "title": "IntegrationSetup",
      "type": "object"
    },
    "IntegrationSourceStatus": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "default": "local",
          "enum": [
            "local",
            "snapshot",
            "public",
            "unavailable"
          ],
          "title": "Access",
          "type": "string"
        },
        "eligibility": {
          "default": "eligible",
          "enum": [
            "eligible",
            "explicit_only",
            "auth_required",
            "contract_unresolved",
            "unsupported"
          ],
          "title": "Eligibility",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "fetched_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fetched At"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "skill",
                "mcp",
                "plugin"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "message": {
          "maxLength": 512,
          "title": "Message",
          "type": "string"
        },
        "snapshot_digest": {
          "default": "",
          "maxLength": 64,
          "title": "Snapshot Digest",
          "type": "string"
        },
        "snapshot_version": {
          "default": "",
          "maxLength": 64,
          "title": "Snapshot Version",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "live",
            "cached",
            "stale",
            "partial",
            "pending",
            "error",
            "empty",
            "timeout",
            "auth_required",
            "rate_limited",
            "malformed",
            "busy",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "status",
        "message",
        "fetched_at"
      ],
      "title": "IntegrationSourceStatus",
      "type": "object"
    },
    "McpPluginTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "plugin",
          "title": "Kind",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "server_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Server Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "plugin_id",
        "server_key"
      ],
      "title": "McpPluginTarget",
      "type": "object"
    },
    "McpStandaloneTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "standalone",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "McpStandaloneTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/IntegrationItem"
      },
      "maxItems": 96,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/IntegrationSourceStatus"
      },
      "maxItems": 24,
      "title": "Sources",
      "type": "array"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "items",
    "total",
    "next_cursor",
    "sources"
  ],
  "title": "IntegrationPage",
  "type": "object"
}
