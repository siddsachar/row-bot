{
  "$defs": {
    "LiveVoiceProvider": {
      "additionalProperties": false,
      "description": "A Live voice option: who hears the audio, its approximate price, and whether its key is saved.",
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "company": {
          "maxLength": 64,
          "title": "Company",
          "type": "string"
        },
        "id": {
          "enum": [
            "openai",
            "gemini",
            "grok"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 64,
          "title": "Label",
          "type": "string"
        },
        "price": {
          "maxLength": 64,
          "title": "Price",
          "type": "string"
        },
        "price_checked": {
          "maxLength": 32,
          "title": "Price Checked",
          "type": "string"
        },
        "reason": {
          "enum": [
            "available",
            "realtime_key_missing",
            "host_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "company",
        "price",
        "price_checked",
        "available",
        "reason"
      ],
      "title": "LiveVoiceProvider",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "browser_dictation_available": {
      "title": "Browser Dictation Available",
      "type": "boolean"
    },
    "live_providers": {
      "items": {
        "$ref": "#/$defs/LiveVoiceProvider"
      },
      "maxItems": 8,
      "title": "Live Providers",
      "type": "array"
    },
    "native_capture_available": {
      "const": false,
      "default": false,
      "title": "Native Capture Available",
      "type": "boolean"
    },
    "read_aloud_reason": {
      "default": "host_unavailable",
      "maxLength": 128,
      "title": "Read Aloud Reason",
      "type": "string"
    },
    "realtime_available": {
      "default": false,
      "title": "Realtime Available",
      "type": "boolean"
    },
    "realtime_reason": {
      "default": "host_unavailable",
      "maxLength": 128,
      "title": "Realtime Reason",
      "type": "string"
    },
    "reason": {
      "enum": [
        "available",
        "host_unavailable"
      ],
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "talk_available": {
      "default": false,
      "title": "Talk Available",
      "type": "boolean"
    },
    "talk_reason": {
      "default": "host_unavailable",
      "maxLength": 128,
      "title": "Talk Reason",
      "type": "string"
    }
  },
  "required": [
    "browser_dictation_available",
    "reason"
  ],
  "title": "DictationCapability",
  "type": "object"
}
