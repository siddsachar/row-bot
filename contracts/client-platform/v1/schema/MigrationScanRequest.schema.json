        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Same Source As"
    },
    "source": {
      "default": "",
      "maxLength": 2048,
      "title": "Source",
      "type": "string"
    },
    "source_grant": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Grant"
    },
    "target": {
      "default": "",
      "maxLength": 2048,
      "title": "Target",
      "type": "string"
    }
