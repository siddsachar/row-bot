{
  "$defs": {
    "DictationHandle": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "server_epoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Server Epoch",
          "type": "string"
        },
        "voice_session_id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Voice Session Id",
          "type": "integer"
        }
      },
      "required": [
        "voice_session_id",
        "server_epoch",
        "lease_id",
        "conversation_id"
      ],
      "title": "DictationHandle",
      "type": "object"
    },
    "TalkSnapshot": {
      "additionalProperties": false,
      "description": "A Row-Bot Voice lease; its live states travel over the voice socket.",
      "properties": {
        "expires_in_ms": {
          "maximum": 360000,
          "minimum": 0,
          "title": "Expires In Ms",
          "type": "integer"
        },
        "handle": {
          "$ref": "#/$defs/DictationHandle"
        },
        "quiesced": {
          "title": "Quiesced",
          "type": "boolean"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "starting",
            "listening",
            "stopping",
            "stopped"
          ],
          "title": "State",
          "type": "string"
        },
        "transport": {
          "const": "row_bot_voice",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "handle",
        "state",
        "quiesced",
        "expires_in_ms",
        "transport"
      ],
      "title": "TalkSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/TalkSnapshot"
    },
    "ticket": {
      "maxLength": 128,
      "minLength": 20,
      "title": "Ticket",
      "type": "string"
    },
    "ticket_expires_in_ms": {
      "maximum": 30000,
      "minimum": 0,
      "title": "Ticket Expires In Ms",
      "type": "integer"
    }
  },
  "required": [
    "snapshot",
    "ticket",
    "ticket_expires_in_ms"
  ],
  "title": "TalkStarted",
  "type": "object"
}
