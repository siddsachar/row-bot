{
  "$defs": {
    "IntegrationMcpPreview": {
      "additionalProperties": false,
      "properties": {
        "auth_requirement": {
          "default": "unknown",
          "enum": [
            "unknown",
            "required",
            "none"
          ],
          "title": "Auth Requirement",
          "type": "string"
        },
        "import_json": {
          "maxLength": 131072,
          "title": "Import Json",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Notes",
          "type": "array"
        },
        "requires_auth": {
          "title": "Requires Auth",
          "type": "boolean"
        },
        "source_url": {
          "maxLength": 2048,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "import_json",
        "requires_auth",
        "notes",
        "source_url"
      ],
      "title": "IntegrationMcpPreview",
      "type": "object"
    },
    "PackageDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 256,
          "title": "Component",
          "type": "string"
        },
        "reason": {
          "maxLength": 1024,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "component",
        "reason"
      ],
      "title": "PackageDiagnostic",
      "type": "object"
    },
    "PortablePackagePreview": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "title": "Adapter Version",
          "type": "integer"
        },
        "archive_digest": {
          "maxLength": 80,
          "title": "Archive Digest",
          "type": "string"
        },
        "compatibility": {
          "enum": [
            "supported",
            "partial"
          ],
          "title": "Compatibility",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/PackageDiagnostic"
          },
          "maxItems": 128,
          "title": "Diagnostics",
          "type": "array"
        },
        "evidence": {
          "maxLength": 512,
          "title": "Evidence",
          "type": "string"
        },
        "format": {
          "maxLength": 64,
          "title": "Format",
          "type": "string"
        },
        "license": {
          "maxLength": 256,
          "title": "License",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Permissions",
          "type": "array"
        },
        "pin": {
          "maxLength": 128,
          "title": "Pin",
          "type": "string"
        },
        "plugin_id": {
          "maxLength": 128,
          "title": "Plugin Id",
          "type": "string"
        },
        "preview_id": {
          "maxLength": 64,
          "title": "Preview Id",
          "type": "string"
        },
        "publisher": {
          "maxLength": 160,
          "title": "Publisher",
          "type": "string"
        },
        "servers": {
          "items": {
            "$ref": "#/$defs/PortableServerPreview"
          },
          "maxItems": 128,
          "title": "Servers",
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/PortableSkillPreview"
          },
          "maxItems": 128,
          "title": "Skills",
          "type": "array"
        },
        "source": {
          "maxLength": 2048,
          "title": "Source",
          "type": "string"
        },
        "tree_digest": {
          "maxLength": 80,
          "title": "Tree Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "preview_id",
        "plugin_id",
        "name",
        "description",
        "version",
        "license",
        "publisher",
        "format",
        "compatibility",
        "diagnostics",
        "source",
        "pin",
        "tree_digest",
        "archive_digest",
        "adapter_version",
        "skills",
        "servers",
        "permissions",
        "evidence"
      ],
      "title": "PortablePackagePreview",
      "type": "object"
    },
    "PortableServerPreview": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Args",
          "type": "array"
        },
        "command": {
          "maxLength": 2048,
          "title": "Command",
          "type": "string"
        },
        "key": {
          "maxLength": 256,
          "title": "Key",
          "type": "string"
        },
        "transport": {
          "maxLength": 32,
          "title": "Transport",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "key",
        "transport",
        "command",
        "args",
        "url"
      ],
      "title": "PortableServerPreview",
      "type": "object"
    },
    "PortableSkillPreview": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1024,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "PortableSkillPreview",
      "type": "object"
    },
    "SkillHubEntryView": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "maxLength": 160,
          "title": "Author",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "title": "Id",
          "type": "string"
        },
        "installed": {
          "title": "Installed",
          "type": "boolean"
        },
        "name": {
          "maxLength": 160,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Tags",
          "type": "array"
        },
        "trust_level": {
          "maxLength": 80,
          "title": "Trust Level",
          "type": "string"
        },
        "url": {
          "default": "",
          "maxLength": 2048,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "source",
        "author",
        "trust_level",
        "tags",
        "installed"
      ],
      "title": "SkillHubEntryView",
      "type": "object"
    },
    "SkillHubFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "maxLength": 256,
          "title": "Path",
          "type": "string"
        },
        "severity": {
          "enum": [
            "block",
            "warn",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "path"
      ],
      "title": "SkillHubFinding",
      "type": "object"
    },
    "SkillHubPreview": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "type": "string"
          },
          "maxItems": 300,
          "title": "Changes",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/SkillHubEntryView"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Files",
          "type": "array"
        },
        "preview_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Preview Id",
          "type": "string"
        },
        "primary_text": {
          "maxLength": 6000,
          "title": "Primary Text",
          "type": "string"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Provenance",
          "type": "array"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Requirements",
          "type": "array"
        },
        "review_files": {
          "items": {
            "$ref": "#/$defs/SkillHubReviewFile"
          },
          "maxItems": 100,
          "title": "Review Files",
          "type": "array"
        },
        "scan": {
          "$ref": "#/$defs/SkillHubScanView"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill_name": {
          "maxLength": 160,
          "title": "Skill Name",
          "type": "string"
        },
        "version": {
          "default": "",
          "maxLength": 256,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "preview_id",
        "content_hash",
        "entry",
        "skill_name",
        "primary_text",
        "files",
        "scan"
      ],
      "title": "SkillHubPreview",
      "type": "object"
    },
    "SkillHubReviewFile": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "title": "Executable",
          "type": "boolean"
        },
        "path": {
          "maxLength": 1024,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "unavailable_reason": {
          "default": "",
          "maxLength": 256,
          "title": "Unavailable Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "executable"
      ],
      "title": "SkillHubReviewFile",
      "type": "object"
    },
    "SkillHubScanView": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/SkillHubFinding"
          },
          "maxItems": 50,
          "title": "Findings",
          "type": "array"
        },
        "token_estimate": {
          "minimum": 0,
          "title": "Token Estimate",
          "type": "integer"
        }
      },
      "required": [
        "blocked",
        "findings",
        "token_estimate"
      ],
      "title": "SkillHubScanView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "plugin",
        "skill",
        "mcp",
        "native"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mcp": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntegrationMcpPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plugin": {
      "anyOf": [
        {
          "$ref": "#/$defs/PortablePackagePreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plugin_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plugin Id"
    },
    "skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillHubPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "kind"
  ],
  "title": "IntegrationPreview",
  "type": "object"
}
