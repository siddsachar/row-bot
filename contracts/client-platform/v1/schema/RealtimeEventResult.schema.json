{
  "$defs": {
    "DictationHandle": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "server_epoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Server Epoch",
          "type": "string"
        },
        "voice_session_id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Voice Session Id",
          "type": "integer"
        }
      },
      "required": [
        "voice_session_id",
        "server_epoch",
        "lease_id",
        "conversation_id"
      ],
      "title": "DictationHandle",
      "type": "object"
    },
    "RealtimeSnapshot": {
      "additionalProperties": false,
      "properties": {
        "expires_in_ms": {
          "maximum": 120000,
          "minimum": 0,
          "title": "Expires In Ms",
          "type": "integer"
        },
        "handle": {
          "$ref": "#/$defs/DictationHandle"
        },
        "quiesced": {
          "title": "Quiesced",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "state": {
          "maxLength": 80,
          "title": "State",
          "type": "string"
        },
        "transport": {
          "const": "openai_realtime",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "handle",
        "state",
        "quiesced",
        "expires_in_ms",
        "run_id",
        "transport"
      ],
      "title": "RealtimeSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "call_id": {
      "maxLength": 128,
      "title": "Call Id",
      "type": "string"
    },
    "caption": {
      "maxLength": 4000,
      "title": "Caption",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "function_output": {
      "maxLength": 8192,
      "title": "Function Output",
      "type": "string"
    },
    "silent": {
      "title": "Silent",
      "type": "boolean"
    },
    "snapshot": {
      "$ref": "#/$defs/RealtimeSnapshot"
    }
  },
  "required": [
    "snapshot",
    "event_id",
    "accepted",
    "caption",
    "call_id",
    "function_output",
    "silent"
  ],
  "title": "RealtimeEventResult",
  "type": "object"
}
