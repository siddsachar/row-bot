{
  "$defs": {
    "KnowledgeRelationPreview": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "incoming",
            "outgoing"
          ],
          "title": "Direction",
          "type": "string"
        },
        "peer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Peer Id",
          "type": "string"
        },
        "peer_subject": {
          "maxLength": 256,
          "title": "Peer Subject",
          "type": "string"
        },
        "relation_type": {
          "maxLength": 64,
          "title": "Relation Type",
          "type": "string"
        }
      },
      "required": [
        "relation_type",
        "direction",
        "peer_id",
        "peer_subject"
      ],
      "title": "KnowledgeRelationPreview",
      "type": "object"
    }
  },
  "additionalProperties": false,
