      "type": "string"
    },
    "resource_revision": {
      "maxLength": 128,
      "title": "Resource Revision",
      "type": "string"
    },
    "status": {
      "enum": [
        "published",
        "submitted",
        "partial",
        "uncertain",
        "denied"
      ],
      "title": "Status",
      "type": "string"
    },
    "submitted_count": {
      "maximum": 200,
      "minimum": 0,
      "title": "Submitted Count",
      "type": "integer"
    },
    "total_count": {
      "maximum": 200,
      "minimum": 0,
      "title": "Total Count",
      "type": "integer"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Url"
