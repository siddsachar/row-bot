{
  "additionalProperties": false,
  "properties": {
    "code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Code"
    },
    "link_kind": {
      "anyOf": [
        {
          "enum": [
            "local",
            "remote_access"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Link Kind"
    },
    "resource_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
