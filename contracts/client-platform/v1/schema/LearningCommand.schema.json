{
  "$defs": {
    "LearningSetupChoices": {
      "additionalProperties": false,
      "properties": {
        "apply_mode": {
          "enum": [
            "ask_first",
            "automatic"
          ],
          "title": "Apply Mode",
          "type": "string"
        },
        "monthly_token_limit": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Monthly Token Limit",
          "type": "integer"
        },
        "sources": {
          "$ref": "#/$defs/LearningSourcesSnapshot"
        },
        "starting_model": {
          "const": "qwen3.5-2b",
          "default": "qwen3.5-2b",
          "title": "Starting Model",
          "type": "string"
        },
        "train_in_quiet_hours": {
          "title": "Train In Quiet Hours",
          "type": "boolean"
        },
        "train_where": {
          "enum": [
            "this_computer",
            "hugging_face"
          ],
          "title": "Train Where",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "apply_mode",
        "monthly_token_limit",
        "train_in_quiet_hours",
        "train_where"
      ],
      "title": "LearningSetupChoices",
      "type": "object"
    },
    "LearningSourcesSnapshot": {
      "additionalProperties": false,
      "properties": {
        "my_chats": {
          "title": "My Chats",
          "type": "boolean"
        },
        "past_chats": {
          "title": "Past Chats",
          "type": "boolean"
        },
        "workflows_and_goals": {
          "title": "Workflows And Goals",
          "type": "boolean"
        }
      },
      "required": [
        "my_chats",
        "workflows_and_goals",
        "past_chats"
      ],
      "title": "LearningSourcesSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "turn_on",
        "turn_off",
        "pause",
        "resume",
        "delete_data",
        "opt_out",
        "opt_in",
        "teach",
        "undo_teach",
        "answer_download",
        "train_now",
        "stop_training",
        "continue_training",
        "discard_training",
        "use_recommended",
        "start_download",
        "stop_download",
        "cancel_download",
        "remove_engine",
        "delete_starting_model"
      ],
      "title": "Action",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "enum": [
            "wrong_answer",
            "wrong_tool_or_step",
            "ignored_instructions",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "client_session_id": {
      "format": "uuid",
      "title": "Client Session Id",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "conversation_id": {
      "default": "",
      "maxLength": 256,
      "title": "Conversation Id",
      "type": "string"
    },
    "download": {
      "anyOf": [
        {
          "enum": [
            "download",
            "not_now"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Download"
    },
    "job_id": {
      "default": "",
      "maxLength": 128,
      "title": "Job Id",
      "type": "string"
    },
    "message_id": {
      "default": "",
      "maxLength": 256,
      "title": "Message Id",
      "type": "string"
    },
    "note": {
      "default": "",
      "maxLength": 2000,
      "title": "Note",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/LearningSetupChoices"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "signal_id": {
      "default": "",
      "maxLength": 128,
      "title": "Signal Id",
      "type": "string"
    },
    "tool_call_id": {
      "default": "",
      "maxLength": 256,
      "title": "Tool Call Id",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "client_session_id",
    "revision",
    "action"
  ],
  "title": "LearningCommand",
  "type": "object"
}
