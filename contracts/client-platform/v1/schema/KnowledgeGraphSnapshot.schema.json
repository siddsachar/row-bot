{
  "$defs": {
    "KnowledgeGraphEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "relation_type": {
          "maxLength": 64,
          "title": "Relation Type",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Target Id",
          "type": "string"
        },
        "updated_at": {
          "maxLength": 128,
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "target_id",
        "relation_type",
        "updated_at"
      ],
      "title": "KnowledgeGraphEdge",
      "type": "object"
    },
    "KnowledgeGraphNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1024,
          "title": "Description",
          "type": "string"
        },
        "entity_type": {
          "maxLength": 64,
          "title": "Entity Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Id",
          "type": "string"
        },
        "is_user": {
          "title": "Is User",
          "type": "boolean"
        },
        "orphan": {
          "title": "Orphan",
          "type": "boolean"
        },
        "relation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Relation Count",
          "type": "integer"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "source": {
          "enum": [
            "manual",
            "extraction",
            "document",
            "wiki",
            "other"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "needs_review",
            "superseded",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "maxLength": 256,
          "title": "Subject",
          "type": "string"
        },
        "tier": {
          "enum": [
            "core",
            "semantic",
            "episodic",
            "resource"
          ],
          "title": "Tier",
          "type": "string"
        },
        "updated_at": {
          "maxLength": 128,
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "subject",
        "description",
        "entity_type",
        "source",
        "updated_at",
        "relation_count",
        "orphan",
        "is_user",
        "status",
        "tier"
      ],
      "title": "KnowledgeGraphNode",
      "type": "object"
    },
    "KnowledgeStatusCounts": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": 0,
          "minimum": 0,
          "title": "Active",
          "type": "integer"
        },
        "archived": {
          "default": 0,
          "minimum": 0,
          "title": "Archived",
          "type": "integer"
        },
        "needs_review": {
          "default": 0,
          "minimum": 0,
          "title": "Needs Review",
          "type": "integer"
        },
        "superseded": {
          "default": 0,
          "minimum": 0,
          "title": "Superseded",
          "type": "integer"
        }
      },
      "title": "KnowledgeStatusCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "enum": [
        "available",
        "missing",
        "unavailable",
        "corrupt"
      ],
      "title": "Availability",
      "type": "string"
    },
    "center_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Center Id"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/KnowledgeGraphEdge"
      },
      "maxItems": 15000,
      "title": "Edges",
      "type": "array"
    },
    "entity_types": {
      "items": {
        "maxLength": 64,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Entity Types",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/KnowledgeGraphNode"
      },
      "maxItems": 5000,
      "title": "Nodes",
      "type": "array"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shown_entities": {
      "maximum": 5000,
      "minimum": 0,
      "title": "Shown Entities",
      "type": "integer"
    },
    "shown_relations": {
      "maximum": 15000,
      "minimum": 0,
      "title": "Shown Relations",
      "type": "integer"
    },
    "sources": {
      "items": {
        "enum": [
          "manual",
          "extraction",
          "document",
          "wiki",
          "other"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "title": "Sources",
      "type": "array"
    },
    "status_counts": {
      "$ref": "#/$defs/KnowledgeStatusCounts"
    },
    "total_entities": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Total Entities",
      "type": "integer"
    },
    "total_relations": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Total Relations",
      "type": "integer"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "availability",
    "revision",
    "nodes",
    "edges",
    "total_entities",
    "total_relations",
    "shown_entities",
    "shown_relations",
    "truncated",
    "center_id",
    "entity_types",
    "sources",
    "status_counts"
  ],
  "title": "KnowledgeGraphSnapshot",
  "type": "object"
}
