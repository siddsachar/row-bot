          "title": "Label",
          "type": "string"
        },
        "memory_gb": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Memory Gb",
          "type": "integer"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "memory_gb",
        "label"
      ],
      "title": "LearningGpu",
      "type": "object"
    },
    "LearningMemory": {
      "additionalProperties": false,
      "properties": {
        "free_gb": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Free Gb",
          "type": "integer"
        },
        "limit_gb": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Limit Gb",
          "type": "integer"
        },
        "system": {
          "enum": [
            "windows",
            "linux",
            "other"
          ],
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "limit_gb",
        "free_gb",
        "system"
      ],
      "title": "LearningMemory",
      "type": "object"
    },
    "LearningStartingModel": {
      "additionalProperties": false,
      "properties": {
        "download_bytes": {
          "minimum": 0,
          "title": "Download Bytes",
          "type": "integer"
        },
        "id": {
          "maxLength": 64,
          "title": "Id",
          "type": "string"
        },
        "licence": {
          "maxLength": 64,
          "title": "Licence",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "licence",
        "download_bytes"
      ],
      "title": "LearningStartingModel",
      "type": "object"
    },
    "LearningTier": {
      "additionalProperties": false,
      "properties": {
        "card_need_gb": {
          "anyOf": [
            {
              "maximum": 4096,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card Need Gb"
        },
        "certified": {
          "title": "Certified",
          "type": "boolean"
        },
        "id": {
          "maxLength": 32,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 32,
