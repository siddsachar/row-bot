{
  "additionalProperties": false,
  "properties": {
    "code": {
      "anyOf": [
        {
          "enum": [
            "mcp_configuration_unconfirmed",
            "mcp_cleanup_incomplete"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Code"
    },
    "revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revision"
    },
    "runtime_cleanup": {
      "enum": [
        "not_requested",
        "not_running",
        "stopped",
        "cleanup_incomplete"
      ],
      "title": "Runtime Cleanup",
      "type": "string"
    },
    "saved_disabled": {
      "anyOf": [
        {
          "const": true,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Saved Disabled"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "server_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Server Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "saved",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "revision",
    "server_ids",
    "saved_disabled",
    "runtime_cleanup",
    "code"
  ],
  "title": "McpConfigurationOutcome",
  "type": "object"
}
