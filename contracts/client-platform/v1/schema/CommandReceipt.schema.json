    "generation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "pass_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pass Id"
    },
    "resource_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "resource_kind": {
      "anyOf": [
        {
          "enum": [
            "artifact",
            "workspace"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Kind"
    },
    "resource_revision": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Revision"
    },
    "revision": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "setup_command_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Setup Command Id"
    },
    "setup_intent": {
      "anyOf": [
        {
          "enum": [
            "create",
            "open",
            "add",
            "repair",
            "new_conversation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Setup Intent"
    },
    "status": {
      "enum": [
        "accepted",
        "completed",
        "cancel_requested",
        "DeleteCompleted",
        "DeleteBlocked",
        "DeleteNotFound",
        "AlreadyDeleting",
        "DeleteRejected",
        "admitting",
        "rejected",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    },
    "submission_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Id"
    }
  },
  "required": [
    "command_id",
    "status"
  ],
  "title": "CommandReceipt",
  "type": "object"
}
