{
  "additionalProperties": false,
  "description": "The draft from a card (``approval_id``), or a rule with an edited command (``rule_id``, ``command``).",
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "command": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "rule_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Id"
    }
  },
  "title": "ApprovalRuleDryRunRequest",
  "type": "object"
}
