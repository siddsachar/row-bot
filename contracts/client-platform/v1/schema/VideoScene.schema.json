{
  "additionalProperties": false,
  "description": "One scene of a video project (5.3.1 B3): a piece of a video, its speed, zoom, card and line.",
  "properties": {
    "approved": {
      "default": false,
      "title": "Approved",
      "type": "boolean"
    },
    "at": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "At"
    },
    "card": {
      "maxLength": 120,
      "title": "Card",
      "type": "string"
    },
    "cue": {
      "default": "",
      "maxLength": 80,
      "title": "Cue",
      "type": "string"
    },
    "effects": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Effects",
      "type": "array"
    },
    "end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "End"
    },
    "footage": {
      "default": "clip",
      "enum": [
        "clip",
        "picture",
        "ai",
        "card",
        "screen"
      ],
      "title": "Footage",
      "type": "string"
    },
    "has_frame": {
      "default": false,
      "title": "Has Frame",
      "type": "boolean"
    },
    "length": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Length"
    },
    "line": {
      "maxLength": 300,
      "title": "Line",
      "type": "string"
    },
    "made": {
      "default": "",
      "enum": [
        "",
        "new",
        "reused"
      ],
      "title": "Made",
      "type": "string"
    },
    "scene_id": {
      "pattern": "^s[0-9a-f]{6}$",
      "title": "Scene Id",
      "type": "string"
    },
    "shows": {
      "default": "",
      "maxLength": 200,
      "title": "Shows",
      "type": "string"
    },
    "source": {
      "maxLength": 512,
      "title": "Source",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ref"
    },
    "speaker": {
      "default": "",
      "maxLength": 40,
      "title": "Speaker",
      "type": "string"
    },
    "speed": {
      "maximum": 4,
      "minimum": 0.25,
      "title": "Speed",
      "type": "number"
    },
    "start": {
      "minimum": 0,
      "title": "Start",
      "type": "number"
    },
    "voice_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice Ref"
    },
    "voiced": {
      "title": "Voiced",
      "type": "boolean"
    },
    "zoom": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Zoom"
    }
  },
  "required": [
    "scene_id",
    "source",
    "start",
    "end",
    "speed",
    "zoom",
    "card",
    "line",
    "voiced",
    "at",
    "length"
  ],
  "title": "VideoScene",
  "type": "object"
}
