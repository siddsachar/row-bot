{
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Conversation Id",
      "type": "string"
    },
    "image_base64": {
      "anyOf": [
        {
          "maxLength": 2000000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Base64"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "available",
        "waiting",
        "shielded",
        "inactive"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "conversation_id",
    "revision",
    "state"
  ],
  "title": "BrowserPreview",
  "type": "object"
}
