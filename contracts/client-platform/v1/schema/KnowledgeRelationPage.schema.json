      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "peer_id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Peer Id",
          "type": "string"
        },
        "peer_subject": {
          "maxLength": 256,
          "title": "Peer Subject",
          "type": "string"
        },
        "relation_type": {
          "maxLength": 64,
          "title": "Relation Type",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Target Id",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_id",
        "target_id",
        "relation_type",
        "confidence",
        "revision",
        "peer_id",
        "peer_subject",
        "truncated"
      ],
      "title": "KnowledgeRelation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "enum": [
        "available",
        "missing",
        "unavailable"
      ],
      "title": "Availability",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/KnowledgeRelation"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "revision": {
      "maxLength": 128,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "total": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Total"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "items",
    "total",
    "next_cursor",
    "availability"
  ],
  "title": "KnowledgeRelationPage",
  "type": "object"
}
