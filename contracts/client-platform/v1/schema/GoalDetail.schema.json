{
  "$defs": {
    "GoalCheck": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "maxLength": 2049,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalCheckResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "runs_in": {
          "maxLength": 257,
          "title": "Runs In",
          "type": "string"
        },
        "state": {
          "enum": [
            "",
            "pending",
            "running",
            "passed",
            "failed",
            "error"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "command",
        "runs_in",
        "state",
        "result"
      ],
      "title": "GoalCheck",
      "type": "object"
    },
    "GoalCheckResult": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "integer"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "finished_at": {
          "maxLength": 64,
          "title": "Finished At",
          "type": "string"
        },
        "output_tail": {
          "maxLength": 8193,
          "title": "Output Tail",
          "type": "string"
        },
        "started_at": {
          "maxLength": 64,
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "exit_code",
        "started_at",
        "finished_at",
        "duration_seconds",
        "output_tail"
      ],
      "title": "GoalCheckResult",
      "type": "object"
    },
    "GoalSummary": {
      "additionalProperties": false,
      "properties": {
        "active_profile_id": {
          "maxLength": 256,
          "title": "Active Profile Id",
          "type": "string"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Blockers",
          "type": "array"
        },
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "done_means": {
          "maxLength": 4097,
          "title": "Done Means",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "last_progress": {
          "maxLength": 2049,
          "title": "Last Progress",
          "type": "string"
        },
        "last_reason": {
          "maxLength": 2049,
          "title": "Last Reason",
          "type": "string"
        },
        "max_minutes": {
          "maximum": 10080,
          "minimum": 0,
          "title": "Max Minutes",
          "type": "integer"
        },
        "max_turns": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "objective": {
          "maxLength": 4096,
          "title": "Objective",
          "type": "string"
        },
        "revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Revision",
          "type": "string"
        },
        "scope": {
          "const": "conversation",
          "title": "Scope",
          "type": "string"
        },
        "started_at": {
          "maxLength": 64,
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "waiting_approval",
            "blocked",
            "completed",
            "cleared"
          ],
          "title": "Status",
          "type": "string"
        },
        "token_budget": {
          "minimum": 0,
          "title": "Token Budget",
          "type": "integer"
        },
        "tokens_used": {
          "minimum": 0,
          "title": "Tokens Used",
          "type": "integer"
        },
        "turns_used": {
          "minimum": 0,
          "title": "Turns Used",
          "type": "integer"
        },
        "window_started_at": {
          "maxLength": 64,
          "title": "Window Started At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "conversation_id",
        "objective",
        "status",
        "revision",
        "turns_used",
        "max_turns",
        "token_budget",
        "tokens_used",
        "started_at",
        "window_started_at",
        "max_minutes",
        "last_progress",
        "last_reason",
        "evidence",
        "blockers",
        "active_profile_id",
        "done_means",
        "check"
      ],
      "title": "GoalSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "goal": {
      "$ref": "#/$defs/GoalSummary"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "goal"
  ],
  "title": "GoalDetail",
  "type": "object"
}
