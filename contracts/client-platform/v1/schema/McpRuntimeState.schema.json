{
  "additionalProperties": false,
  "properties": {
    "availability": {
      "enum": [
        "available",
        "missing",
        "unavailable",
        "recovery_required"
      ],
      "title": "Availability",
      "type": "string"
    },
    "cleanup_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cleanup Revision"
    },
    "configuration_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Configuration Revision"
    },
    "runtime_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Runtime Id"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "server_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Server Id",
      "type": "string"
    },
    "session_quiesced": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Quiesced"
    },
    "state": {
      "enum": [
        "not_started",
        "connecting",
        "connected",
        "stopping",
        "stopped",
        "failed",
        "dependency_missing",
        "cleanup_incomplete",
        "unknown",
        "missing"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "server_id",
    "configuration_revision",
    "cleanup_revision",
    "availability",
    "runtime_id",
    "state",
    "session_quiesced"
  ],
  "title": "McpRuntimeState",
  "type": "object"
}
