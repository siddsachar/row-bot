{
  "$defs": {
    "DictationHandle": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "server_epoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Server Epoch",
          "type": "string"
        },
        "voice_session_id": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Voice Session Id",
          "type": "integer"
        }
      },
      "required": [
        "voice_session_id",
        "server_epoch",
        "lease_id",
        "conversation_id"
      ],
      "title": "DictationHandle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "handle": {
      "$ref": "#/$defs/DictationHandle"
    },
    "output_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Id"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "state": {
      "enum": [
        "idle",
        "running",
        "stopping",
        "completed",
        "stopped",
        "failed",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Text"
    }
  },
  "required": [
    "handle",
    "run_id",
    "state",
    "output_id",
    "text"
  ],
  "title": "VoiceRunView",
  "type": "object"
}
