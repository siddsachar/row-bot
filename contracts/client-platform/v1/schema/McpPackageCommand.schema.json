{
  "$defs": {
    "McpPluginTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "plugin",
          "title": "Kind",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "title": "Plugin Id",
          "type": "string"
        },
        "server_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Server Key",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "plugin_id",
        "server_key"
      ],
      "title": "McpPluginTarget",
      "type": "object"
    },
    "McpStandaloneTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "standalone",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "McpStandaloneTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_session_id": {
      "format": "uuid",
      "title": "Client Session Id",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "configuration_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Revision",
      "type": "string"
    },
    "digest": {
      "maxLength": 128,
      "title": "Digest",
      "type": "string"
    },
    "nonce": {
      "maxLength": 256,
      "title": "Nonce",
      "type": "string"
    },
    "preview_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Preview Id",
      "type": "string"
    },
    "server_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Server Id",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpStandaloneTarget"
        },
        {
          "$ref": "#/$defs/McpPluginTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    }
  },
  "required": [
    "server_id",
    "configuration_revision",
    "command_id",
    "client_session_id",
    "preview_id",
    "digest",
    "nonce"
  ],
  "title": "McpPackageCommand",
  "type": "object"
}
