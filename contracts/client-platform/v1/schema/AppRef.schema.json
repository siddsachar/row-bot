{
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "productivity",
        "developer",
        "data",
        "design",
        "communication",
        "finance",
        "local_tools"
      ],
      "title": "Category",
      "type": "string"
    },
    "featured_rank": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Featured Rank"
    },
    "icon": {
      "pattern": "^(si:[a-z0-9]{1,64}|letter:[A-Z0-9]|cached:[0-9a-f]{32})$",
      "title": "Icon",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "title": "Name",
      "type": "string"
    },
    "publisher": {
      "maxLength": 128,
      "title": "Publisher",
      "type": "string"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "publisher",
    "category",
    "icon",
    "verified"
  ],
  "title": "AppRef",
  "type": "object"
}
