{
  "id": "/app-v2/",
  "name": "Row-Bot",
  "short_name": "Row-Bot",
  "description": "Your local-first Row-Bot workspace",
  "start_url": "/app-v2/",
  "scope": "/app-v2/",
  "display": "standalone",
  "background_color": "#f4f7fb",
  "theme_color": "#315f8f",
  "icons": [
    {
      "src": "/app-v2/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-v2/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-v2/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app-v2/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New chat",
      "url": "/app-v2/?new=chat",
      "icons": [
        {
          "src": "/app-v2/icon-maskable-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    },
    {
      "name": "Home",
      "url": "/app-v2/",
      "icons": [
        {
          "src": "/app-v2/icon-maskable-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/app-v2/screenshot-phone.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Row-Bot Home on a phone"
    },
    {
      "src": "/app-v2/screenshot-wide.webp",
      "sizes": "1440x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Row-Bot Home on a computer"
    }
  ]
}
